<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure domain logic: units, ids, calculations and AI-output validators. No file, network or
    database I/O, and no ambient clock or randomness (pass a TimeProvider or a random source in).
    BannedSymbols.txt enforces this at build time. Keep package references to a minimum.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
