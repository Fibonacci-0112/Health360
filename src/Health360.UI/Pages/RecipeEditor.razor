@page "/food/recipes/new"
@page "/food/recipes/{RecipeId}"
@using System.Globalization
@using FluentValidation
@using Health360.Contracts.Body
@using Health360.Contracts.Nutrition
@using Health360.Domain.Nutrition
@using Health360.Domain.Units
@implements IDisposable
@inject FoodService Foods
@inject ProfileService Profiles
@inject NavigationManager Navigation
@inject ILogger<RecipeEditor> Logger

<div class="page">
    <div class="page-head">
        <h1>@(RecipeId is null ? "New recipe" : "Edit recipe")</h1>
        <NavLink class="top-link" href="food/recipes">Recipes</NavLink>
    </div>
    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    @if (!loaded)
    {
        <p class="muted" role="status">Loading</p>
    }
    else if (notFound)
    {
        <p class="muted">This recipe is no longer on this device.</p>
    }
    else if (RecipeId is null && households.Length == 0)
    {
        <p class="muted">Recipes are shared with your household. Your household hasn't synced to this device yet.</p>
    }
    else
    {
        @if (incomplete)
        {
            <p class="muted" id="recipe-incomplete">Some of this recipe's ingredients haven't synced to this device yet, so it can be viewed here but not saved.</p>
        }
        <form class="form" id="recipe-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <section class="card" aria-labelledby="recipe-details-title">
                <h2 id="recipe-details-title">Recipe</h2>
                @if (RecipeId is null && households.Length > 1)
                {
                    <div class="field"><label for="recipe-household">Household</label>
                        <select id="recipe-household" value="@householdId" @onchange="HouseholdChanged">
                            @foreach (var household in households) { <option value="@household.Id">@household.Name</option> }
                        </select></div>
                }
                <div class="field"><label for="recipe-name">Name</label><input id="recipe-name" @bind="name" @bind:event="oninput" /></div>
                <div class="field"><label for="recipe-servings">Servings it makes</label><input id="recipe-servings" inputmode="decimal" @bind="servings" @bind:event="oninput" /></div>
                <div class="field">
                    <label for="recipe-cooked">Cooked weight (optional)</label>
                    <div class="inline">
                        <input id="recipe-cooked" inputmode="decimal" @bind="cookedWeight" @bind:event="oninput" />
                        <select id="recipe-cooked-unit" aria-label="Cooked weight unit" @bind="cookedUnit">
                            @foreach (var unitCode in RecipeInputValidator.CookedWeightUnits) { <option value="@unitCode">@unitCode</option> }
                        </select>
                    </div>
                </div>
                <p class="muted small">Weigh the finished dish to log it by weight later. Without it, servings are the only measure (or the raw ingredients' weight, when every one is weighed).</p>
            </section>

            <section class="card" aria-labelledby="recipe-ingredients-title">
                <h2 id="recipe-ingredients-title">Ingredients</h2>
                @if (rows.Count == 0)
                {
                    <p class="muted">No ingredients yet. Find your household's foods below.</p>
                }
                <ul class="measurement-list" id="ingredient-list">
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var index = i;
                        var row = rows[i];
                        <li class="measurement ingredient" @key="row">
                            <span class="measurement-text"><span>@row.FoodName</span>
                                @if (row.Food is null) { <span class="muted small">Not on this device yet</span> }</span>
                            <span class="inline">
                                <input class="set-input" inputmode="decimal" aria-label="@($"{row.FoodName} amount")" @bind="row.Amount" @bind:event="oninput" disabled="@(row.Food is null)" />
                                <select aria-label="@($"{row.FoodName} unit")" @bind="row.Unit" disabled="@(row.Food is null)">
                                    @if (row.Food is { } food)
                                    {
                                        @if (RetiredPortion(row) is { } retired) { <option value="@row.Unit">× @retired (no longer listed)</option> }
                                        @foreach (var portion in food.Portions) { <option value="@("portion:" + portion.Name)">× @portion.Name</option> }
                                        @foreach (var unitCode in FoodLog.UnitsFor(food.Basis)) { <option value="@unitCode">@UnitName(unitCode)</option> }
                                    }
                                    else
                                    {
                                        <option value="@row.Unit">@row.Unit</option>
                                    }
                                </select>
                                <button type="button" class="secondary compact" aria-label="@($"Move {row.FoodName} up")" disabled="@(index == 0)" @onclick="() => Move(index, -1)">↑</button>
                                <button type="button" class="secondary compact" aria-label="@($"Move {row.FoodName} down")" disabled="@(index == rows.Count - 1)" @onclick="() => Move(index, 1)">↓</button>
                                <button type="button" class="secondary compact" aria-label="@($"Remove {row.FoodName}")" @onclick="() => rows.RemoveAt(index)">Remove</button>
                            </span>
                        </li>
                    }
                </ul>
                <div class="field">
                    <label for="ingredient-search">Add an ingredient</label>
                    <input id="ingredient-search" type="search" value="@query" @oninput="SearchAsync" autocomplete="off" />
                </div>
                @if (matches.Length > 0)
                {
                    <ul class="measurement-list" id="ingredient-matches">
                        @foreach (var match in matches)
                        {
                            <li class="measurement">
                                <span>@match.Name@(match.Brand is null ? "" : $" ({match.Brand})")</span>
                                <button type="button" class="secondary compact" aria-label="@($"Add {match.Name}")" @onclick="() => Add(match)">Add</button>
                            </li>
                        }
                    </ul>
                }
                @if (CatalogueShown.Count > 0)
                {
                    <p class="muted small">From the USDA catalogue (added to your household when you use it)</p>
                    <ul class="measurement-list" id="ingredient-catalogue">
                        @foreach (var row in CatalogueShown)
                        {
                            <li class="measurement">
                                <span>@row.Name@(row.Brand is null ? "" : $" ({row.Brand})")</span>
                                <button type="button" class="secondary compact" disabled="@(copying || busy)" aria-label="@($"Add {row.Name} from the USDA catalogue")" @onclick="() => AddFromCatalogueAsync(row)">Add</button>
                            </li>
                        }
                    </ul>
                }
                @if (catalogueNote is not null)
                {
                    <p class="muted small" id="ingredient-catalogue-note">@catalogueNote</p>
                }
                @if (matches.Length == 0 && CatalogueShown.Count == 0 && catalogueSearched && !string.IsNullOrWhiteSpace(query))
                {
                    <p class="muted">Nothing matches. Add the food on the Food tab first.</p>
                }
            </section>

            <section class="card" aria-labelledby="recipe-nutrition-title">
                <h2 id="recipe-nutrition-title">Nutrition</h2>
                <div id="recipe-nutrition">@NutritionText()</div>
            </section>

            <div class="inline">
                <button type="submit" class="primary" id="save-recipe" disabled="@(busy || copying || incomplete)">Save recipe</button>
                @if (RecipeId is not null)
                {
                    @if (confirmDelete)
                    {
                        <div class="confirm" role="alertdialog" aria-labelledby="recipe-confirm">
                            <p id="recipe-confirm">Delete @name for the whole household? Entries already logged from it stay.</p>
                            <div class="inline">
                                <button type="button" class="danger" id="delete-recipe-confirm" disabled="@busy" @onclick="DeleteAsync">Delete</button>
                                <button type="button" class="secondary" disabled="@busy" @onclick="() => confirmDelete = false">Keep</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="secondary" id="delete-recipe" @onclick="() => confirmDelete = true">Delete recipe</button>
                    }
                }
            </div>
        </form>
    }
</div>

@code {
    [Parameter] public string? RecipeId { get; set; }

    private string? owner, error;
    private bool loaded, notFound, incomplete, busy, confirmDelete;
    private WorkoutService.HouseholdChoice[] households = [];
    private string householdId = "", name = "", servings = "1", cookedWeight = "", cookedUnit = "g", query = "";
    private readonly List<Row> rows = [];
    private FoodRow[] matches = [];

    // The catalogue's answer for the current query, and a line about it when it couldn't be searched.
    private FoodRow[] catalogueMatches = [];
    private string? catalogueNote;
    private bool catalogueSearched, copying;

    /// <summary>
    /// Catalogue matches, less those whose copy in the recipe's household is listed with its foods just above. A copy
    /// beyond that list's limit isn't listed, so its catalogue row stays, and adding it reuses the copy.
    /// </summary>
    private IReadOnlyList<FoodRow> CatalogueShown => Guid.TryParse(householdId, out var household)
        ? [.. catalogueMatches.Where(row => !(Guid.TryParse(row.Id, out var food)
            && matches.Any(m => m.Id == FoodCopy.IdFor(household, food).ToString("D"))))]
        : catalogueMatches;

    private bool subscribed, started;
    private string? shownRecipeId;

    // Bumped by every load: a read that started for the recipe shown before leaves the form alone.
    private int loadGeneration;

    // The same editor serves /food/recipes/new and /food/recipes/{id}, so moving between them changes only the
    // parameter: the form is loaded afresh whenever the recipe it shows changes.
    protected override async Task OnParametersSetAsync()
    {
        if (!subscribed)
        {
            subscribed = true;
            owner = Foods.ProfileId;
            Profiles.Changed += ProfileChanged;
        }

        if (started && RecipeId == shownRecipeId) return;
        started = true;
        shownRecipeId = RecipeId;
        var generation = ++loadGeneration;
        watch?.Cancel();
        watch?.Dispose();
        watch = null;
        loaded = notFound = incomplete = confirmDelete = false;
        error = null;
        households = [];
        householdId = name = cookedWeight = query = "";
        // Another recipe's search, the catalogue's part included, doesn't apply to this one.
        matches = [];
        catalogueMatches = [];
        catalogueNote = null;
        catalogueSearched = false;
        servings = "1";
        cookedUnit = "g";
        rows.Clear();
        matches = [];
        if (owner is null)
        {
            Navigation.NavigateTo("food");
            return;
        }

        try
        {
            var loadedHouseholds = await Foods.HouseholdsAsync();
            var recipe = RecipeId is null ? null : await Foods.RecipeAsync(RecipeId);
            if (generation != loadGeneration) return;
            households = loadedHouseholds;
            if (RecipeId is null)
            {
                householdId = households.FirstOrDefault()?.Id ?? "";
            }
            else if (recipe is not null)
            {
                householdId = recipe.Recipe.HouseholdId;
                name = recipe.Recipe.Name;
                servings = recipe.Recipe.Servings.ToString(CultureInfo.InvariantCulture);
                cookedWeight = recipe.Recipe.CookedWeight?.ToString(CultureInfo.InvariantCulture) ?? "";
                cookedUnit = recipe.Recipe.CookedWeightUnit ?? "g";
                incomplete = !recipe.Complete;
                rows.AddRange(recipe.Ingredients.Select(i => new Row
                {
                    Id = i.Id, FoodId = i.FoodId, FoodName = i.FoodName ?? "Unknown food", Food = i.Food(),
                    Amount = i.Quantity.ToString(CultureInfo.InvariantCulture),
                    Unit = i.QuantityUnit == "portion" ? "portion:" + i.PortionName : i.QuantityUnit,
                    Saved = new SavedAmount(i.FoodId, i.Quantity, i.QuantityUnit == "portion" ? "portion:" + i.PortionName : i.QuantityUnit, i.BaseAmount),
                }));
            }
            else
            {
                notFound = true;
            }
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            if (generation != loadGeneration) return;
            LogFailed(Logger, "recipe", e.GetType().Name);
            error = "Couldn't read the recipe on this device. Leave this page and come back to try again.";
        }

        loaded = true;
        WatchSync(generation);
    }

    private CancellationTokenSource? watch;

    /// <summary>
    /// Fills in what syncs while the editor is open: the households for a new recipe, and the foods of ingredients that
    /// hadn't reached this device. What the user has typed is left as it is.
    /// </summary>
    private const string RefreshFailed = "Couldn't refresh this recipe from what has synced. Leave this page and come back to try again.";

    // The kind of read and the exception's type only: never names, amounts or rows.
    private static readonly Action<ILogger, string, string, Exception?> FailedMessage =
        LoggerMessage.Define<string, string>(LogLevel.Warning, new EventId(1, "RecipeReadFailed"), "The recipe editor couldn't read the {What}: {Error}");

    private static void LogFailed(ILogger logger, string what, string error) => FailedMessage(logger, what, error, null);

    private void WatchSync(int generation)
    {
        if (notFound || owner is null || generation != loadGeneration) return;
        watch = new CancellationTokenSource();
        var token = watch.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var _ in Foods.WatchChoices(token))
                {
                    await InvokeAsync(async () =>
                    {
                        if (token.IsCancellationRequested || owner != Foods.ProfileId || generation != loadGeneration) return;
                        try
                        {
                            await RefreshSyncedAsync(generation);
                            if (error == RefreshFailed) error = null;
                        }
                        catch (Exception e) when (e is not OperationCanceledException)
                        {
                            // One failed refresh is reported; the watch keeps listening, so the next change tries again.
                            if (generation != loadGeneration) return;
                            LogFailed(Logger, "synced changes", e.GetType().Name);
                            error = RefreshFailed;
                        }

                        if (!token.IsCancellationRequested) StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception e) when (e is not ObjectDisposedException)
            {
                LogFailed(Logger, "sync watch", e.GetType().Name);
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested || generation != loadGeneration) return;
                    error = RefreshFailed;
                    StateHasChanged();
                });
            }
        }, CancellationToken.None);
    }

    private async Task RefreshSyncedAsync(int generation)
    {
        if (RecipeId is null)
        {
            // Every membership that syncs is offered; the household already chosen stays chosen.
            var next = await Foods.HouseholdsAsync();
            if (generation != loadGeneration) return;
            households = next;
            if (!households.Any(h => h.Id == householdId))
            {
                // The chosen household went away: its foods can't go in another household's recipe.
                var hadOne = !string.IsNullOrEmpty(householdId);
                householdId = households.FirstOrDefault()?.Id ?? "";
                if (hadOne) ClearIngredients();
            }

            return;
        }

        if (!incomplete) return;
        var recipe = await Foods.RecipeAsync(RecipeId);
        if (generation != loadGeneration || recipe is null || recipe.Recipe.Id != shownRecipeId) return;
        foreach (var ingredient in recipe.Ingredients)
        {
            if (rows.FirstOrDefault(r => r.Id == ingredient.Id) is { Food: null } row && ingredient.Food() is { } food)
            {
                row.Food = food;
                row.FoodName = food.Name;
            }
        }

        incomplete = !recipe.Complete;
    }

    private void ProfileChanged() => _ = InvokeAsync(() =>
    {
        // Another profile's household recipes aren't this one's to edit.
        if (Foods.ProfileId != owner) Navigation.NavigateTo("food");
    });

    private void HouseholdChanged(ChangeEventArgs e)
    {
        householdId = e.Value?.ToString() ?? "";
        ClearIngredients();
    }

    /// <summary>Ingredients must be foods of the recipe's own household, so a change of household starts them afresh.</summary>
    private void ClearIngredients()
    {
        rows.Clear();
        matches = [];
        query = "";
        catalogueMatches = [];
        catalogueNote = null;
        catalogueSearched = false;
        if (error == SearchFailed) error = null;
    }

    private const string SearchFailed = "Couldn't search your household's foods on this device. Try again.";

    private async Task SearchAsync(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        var asked = query;
        var household = householdId;
        catalogueMatches = [];
        catalogueNote = null;
        catalogueSearched = false;
        if (string.IsNullOrWhiteSpace(asked))
        {
            matches = [];
            return;
        }

        try
        {
            // Only the recipe's household's foods, filtered before the limit, so another household's can't crowd them out.
            var found = await Foods.SearchAsync(asked, household);
            // A search for other text, or for the household chosen before, no longer applies.
            if (asked == query && household == householdId && owner == Foods.ProfileId)
            {
                matches = found;
                if (error == SearchFailed) error = null;
            }
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            if (asked == query && household == householdId) error = SearchFailed;
        }

        await SearchCatalogueAsync(asked, household);
    }

    /// <summary>The online catalogue, after the household's own foods are listed, so a slow request never holds them up.</summary>
    private async Task SearchCatalogueAsync(string asked, string household)
    {
        if (asked.Trim().Length < PostgrestCatalogueSearch.MinimumQueryLength)
        {
            catalogueSearched = true;
            return;
        }

        var started = owner;
        StateHasChanged();
        CatalogueSearchResult answer;
        try
        {
            answer = await Foods.SearchCatalogueAsync(asked);
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            LogFailed(Logger, "catalogue", x.GetType().Name);
            answer = CatalogueSearchResult.Of(CatalogueSearchStatus.Unavailable);
        }

        if (asked != query || household != householdId || started != owner || owner != Foods.ProfileId) return;
        catalogueSearched = true;
        catalogueMatches = [.. answer.Foods];
        catalogueNote = answer.Status switch
        {
            CatalogueSearchStatus.SignedOut => "Sign in again to search the USDA catalogue.",
            CatalogueSearchStatus.Unavailable => "The USDA catalogue couldn't be searched, so you may be offline. Your household's foods are listed as usual.",
            _ => null,
        };
    }

    /// <summary>
    /// Copies a catalogue food into the recipe's household (or reuses the copy there) and adds it as an ingredient:
    /// ingredients are always the household's own foods, so the recipe totals offline on every member's device.
    /// </summary>
    private async Task AddFromCatalogueAsync(FoodRow row)
    {
        // Not while saving: the ingredient would arrive after the save was taken.
        if (copying || busy) return;
        var household = householdId;
        var started = owner;
        // The recipe it was asked for: one opened meanwhile, in the same household or not, doesn't get the ingredient.
        var generation = loadGeneration;
        if (string.IsNullOrEmpty(household))
        {
            error = "Choose a household first.";
            return;
        }

        copying = true;
        try
        {
            var id = await Foods.CopyFromCatalogueAsync(household, row);
            var copy = await Foods.FoodAsync(id);
            if (generation != loadGeneration || household != householdId || started != owner || owner != Foods.ProfileId) return;
            if (copy is null)
            {
                error = $"{row.Name} couldn't be added to your household on this device.";
                return;
            }

            Add(copy);
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            LogFailed(Logger, "catalogue copy", x.GetType().Name);
            if (generation == loadGeneration && household == householdId && started == owner)
                error = $"{row.Name} couldn't be added to your household on this device. Try again.";
        }
        finally
        {
            copying = false;
        }
    }

    private void Add(FoodRow match)
    {
        if (match.ToFood() is not { } food)
        {
            error = $"{match.Name} can't be read on this device.";
            return;
        }

        var prefs = Foods.UnitPrefs;
        rows.Add(new Row
        {
            FoodId = food.Id, FoodName = food.Name, Food = food,
            Amount = food.Portions.Count > 0 ? "1" : "",
            Unit = food.Portions.Count > 0
                ? "portion:" + food.Portions[0].Name
                : food.Basis == FoodBasis.Mass ? UnitPrefOptions.FoodMass.ToCode(prefs.FoodMass) : UnitPrefOptions.Volume.ToCode(prefs.Volume),
        });
        query = "";
        matches = [];
        catalogueMatches = [];
        catalogueNote = null;
        catalogueSearched = false;
    }

    private void Move(int index, int by)
    {
        var target = index + by;
        if (target < 0 || target >= rows.Count) return;
        (rows[index], rows[target]) = (rows[target], rows[index]);
    }

    /// <summary>What the recipe holds as entered so far, through the same calculation saving and logging use.</summary>
    private RenderFragment NutritionText() => builder =>
    {
        string text;
        if (incomplete)
        {
            text = "Shown once every ingredient has synced to this device.";
        }
        else if (rows.Count == 0)
        {
            text = "Add ingredients to see what the recipe holds.";
        }
        else if (NumberText.Parse(servings) is not { } count || count <= 0)
        {
            text = "Enter how many servings it makes.";
        }
        else
        {
            try
            {
                var ingredients = rows.Select(r =>
                {
                    var quantity = NumberText.Parse(r.Amount) ?? throw new ArgumentException($"Enter an amount for {r.FoodName}.");
                    return new RecipeIngredient(r.Food!.Per100, r.Food.Basis, BaseAmount(r, quantity));
                }).ToList();
                var cooked = NumberText.Parse(cookedWeight) is { } w && w > 0 ? UnitCodes.Convert(w, cookedUnit, "g") : null;
                var nutrition = RecipeNutrition.Compute(ingredients, count, cooked);
                builder.OpenElement(0, "p");
                builder.AddContent(1, "Per serving: " + Macros(nutrition.PerServing));
                builder.CloseElement();
                builder.OpenElement(2, "p");
                builder.AddAttribute(3, "class", "muted small");
                builder.AddContent(4, "Whole recipe: " + Macros(nutrition.Total)
                    + (nutrition.Per100g is { } per100 ? $" · per 100 g of the dish: {Macros(per100, energyOnly: true)}" : " · weigh the dish to log it by weight"));
                builder.CloseElement();
                if (Nutrient.Macros.Any(n => nutrition.Total.Incomplete.Contains(n.Code)))
                {
                    builder.OpenElement(5, "p");
                    builder.AddAttribute(6, "class", "muted small");
                    builder.AddContent(7, "\"At least\": some ingredients don't list that value.");
                    builder.CloseElement();
                }

                return;
            }
            catch (ArgumentException e)
            {
                text = e.Message;
            }
        }

        builder.OpenElement(8, "p");
        builder.AddAttribute(9, "class", "muted");
        builder.AddContent(10, text);
        builder.CloseElement();
    };

    private string Macros(NutrientTotal total, bool energyOnly = false) => string.Join(" · ",
        (energyOnly ? [Nutrient.Energy] : Nutrient.Macros).Select(n => total.Amounts[n] is { } v
            ? (total.Incomplete.Contains(n.Code) ? "at least " : "") + (n == Nutrient.Energy ? MetricDisplay.Energy(v, Foods.UnitPrefs.Energy) : $"{MetricDisplay.Format(v, "g")} {n.Code}")
            : $"{n.Code} not listed"));

    private async Task SaveAsync()
    {
        // Not while a catalogue ingredient is being copied: the save would be taken before it is added.
        if (busy || copying || incomplete || owner != Foods.ProfileId) return;
        busy = true;
        error = null;
        try
        {
            var count = NumberText.Parse(servings) ?? throw new ArgumentException("Enter how many servings it makes as a number.");
            double? cooked = string.IsNullOrWhiteSpace(cookedWeight)
                ? null
                : NumberText.Parse(cookedWeight) ?? throw new ArgumentException("Enter the cooked weight as a number, or leave it blank.");
            var ingredients = rows.Select(r =>
            {
                var quantity = NumberText.Parse(r.Amount) ?? throw new ArgumentException($"Enter an amount for {r.FoodName}.");
                CheckRetired(r, quantity);
                var (unit, portion) = Split(r.Unit);
                return new RecipeIngredientInput(r.Id, r.FoodId, quantity, unit, portion);
            }).ToList();
            var input = new RecipeInput(name, count, cooked, cooked is null ? null : cookedUnit, ingredients);
            if (RecipeId is null)
            {
                if (string.IsNullOrEmpty(householdId)) throw new ArgumentException("Choose a household first.");
                await Foods.CreateRecipeAsync(householdId, input);
            }
            else
            {
                await Foods.UpdateRecipeAsync(RecipeId, input);
            }

            if (owner == Foods.ProfileId) Navigation.NavigateTo("food/recipes");
        }
        catch (ValidationException e)
        {
            error = string.Join(" ", e.Errors.Select(x => x.ErrorMessage).Distinct(StringComparer.Ordinal));
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException)
        {
            error = e.Message;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            error = "Couldn't save the recipe on this device. Try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (busy || RecipeId is null || owner != Foods.ProfileId) return;
        busy = true;
        error = null;
        try
        {
            await Foods.DeleteRecipeAsync(RecipeId);
            if (owner == Foods.ProfileId) Navigation.NavigateTo("food/recipes");
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            error = "Couldn't delete the recipe on this device. Try again.";
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>
    /// An ingredient's amount in its food's basis: the stored amount while it is as saved (the server keeps that amount
    /// even if the food's portion changed since), otherwise computed from what is entered now.
    /// </summary>
    private static double BaseAmount(Row row, double quantity)
    {
        if (Unchanged(row, quantity)) return row.Saved!.BaseAmount;
        CheckRetired(row, quantity);
        var (unit, portion) = Split(row.Unit);
        return FoodLog.Compute(row.Food!, quantity, unit, portion).BaseAmount;
    }

    private static bool Unchanged(Row row, double quantity) =>
        row.Saved is { } saved && saved.FoodId == row.FoodId && saved.Quantity.Equals(quantity) && saved.Unit == row.Unit;

    /// <summary>The saved portion's name when the food no longer lists it, or null.</summary>
    private static string? RetiredPortion(Row row) =>
        row.Food is { } food && Split(row.Unit) is (null, { } portion) && food.Portions.All(p => p.Name != portion) ? portion : null;

    /// <summary>A portion the food no longer lists can stay as saved, but can't be given a new amount.</summary>
    private static void CheckRetired(Row row, double quantity)
    {
        if (RetiredPortion(row) is { } portion && !Unchanged(row, quantity))
        {
            throw new ArgumentException($"{row.FoodName} no longer lists \"{portion}\": choose another unit or portion to change its amount.");
        }
    }

    private static (string? Unit, string? Portion) Split(string unit) =>
        unit.StartsWith("portion:", StringComparison.Ordinal) ? (null, unit["portion:".Length..]) : (unit, null);

    private static string UnitName(string code) => code switch
    {
        "fl_oz" => "fl oz",
        "cup" => "cups",
        "l" => "L",
        _ => code,
    };

    public void Dispose()
    {
        Profiles.Changed -= ProfileChanged;
        watch?.Cancel();
        watch?.Dispose();
    }

    /// <summary>An ingredient as it was saved: what was entered and the amount the database holds.</summary>
    private sealed record SavedAmount(string FoodId, double Quantity, string Unit, double BaseAmount);

    private sealed class Row
    {
        public string? Id { get; set; }

        public string FoodId { get; set; } = "";

        public string FoodName { get; set; } = "";

        public LoggableFood? Food { get; set; }

        public string Amount { get; set; } = "";

        public string Unit { get; set; } = "";

        public SavedAmount? Saved { get; init; }
    }
}
