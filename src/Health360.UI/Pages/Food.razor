@page "/food"
@using System.Globalization
@using FluentValidation
@using Health360.Contracts.Body
@using Health360.Contracts.Nutrition
@using Health360.Domain.Nutrition
@using Health360.Domain.Units
@implements IDisposable
@inject FoodService Foods
@inject ProfileService Profiles
@inject ILogger<Food> Logger

<div class="page">
    <div class="page-head">
        <h1>Food</h1>
    </div>
    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    <p role="status">@status</p>
    @if (watchedProfile is null)
    {
        <p class="muted" role="status">Waiting for your profile to sync to this device</p>
    }
    else
    {
        <div class="inline" role="group" aria-label="Day">
            <button type="button" class="secondary" id="food-previous" @onclick="() => MoveAsync(-1)">Previous day</button>
            <input id="food-date" type="date" aria-label="Date" value="@date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" @onchange="DateChangedAsync" />
            <button type="button" class="secondary" id="food-next" @onclick="() => MoveAsync(1)">Next day</button>
            @if (date != Foods.Today)
            {
                <button type="button" class="secondary" id="food-today" @onclick="() => MoveAsync(Foods.Today.DayNumber - date.DayNumber)">Today</button>
            }
        </div>

        <section class="card" aria-labelledby="food-total-title">
            <h2 id="food-total-title">@(date == Foods.Today ? "Today" : date.ToString("dddd, d MMMM", CultureInfo.CurrentCulture))</h2>
            @if (readFailed)
            {
                <p class="muted">This day couldn't be read on this device.</p>
            }
            else if (!loaded)
            {
                <p class="muted" role="status">Loading your food log</p>
            }
            else if (entries.Length == 0)
            {
                <p class="muted">Nothing logged on this day yet.</p>
            }
            else
            {
                <dl class="values" id="food-totals">
                    @foreach (var nutrient in Nutrient.Macros)
                    {
                        <div class="value-row"><dt>@MacroName(nutrient)</dt><dd>@TotalText(nutrient)</dd></div>
                    }
                </dl>
                @if (Nutrient.Macros.Any(n => total.Incomplete.Contains(n.Code)))
                {
                    <p class="muted small">"At least": some entries don't list that value, so the total counts only those that do.</p>
                }
            }
        </section>

        <TargetsCard Total="@DayTotal" IsToday="@(date == Foods.Today)" />

        @foreach (var meal in FoodLog.Meals)
        {
            var mealEntries = entries.Where(e => e.Meal == meal).ToList();
            if (mealEntries.Count == 0) continue;
            <section class="card" aria-labelledby="@($"meal-{meal}-title")">
                <h2 id="@($"meal-{meal}-title")">@MealName(meal) · @EnergyText(FoodLog.Total(mealEntries))</h2>
                <ul class="measurement-list">
                    @foreach (var entry in mealEntries)
                    {
                        <li class="measurement food-entry" data-entry="@entry.Id">
                            <span class="measurement-text">
                                <span>@entry.Name@(entry.Brand is null ? "" : $" ({entry.Brand})")</span>
                                <span class="muted small">@AmountText(entry)@(entry.Energy is { } kcal ? $" · {MetricDisplay.Energy(kcal, Foods.UnitPrefs.Energy)}" : " · energy not listed")</span>
                            </span>
                            @if (confirmDelete == entry.Id)
                            {
                                <div class="confirm" role="alertdialog" aria-labelledby="@($"food-confirm-{entry.Id}")">
                                    <p id="@($"food-confirm-{entry.Id}")">Delete @entry.Name from @MealName(entry.Meal).ToLowerInvariant()?</p>
                                    <div class="inline">
                                        <button type="button" class="danger" disabled="@busy" @onclick="() => DeleteAsync(entry.Id)">Delete</button>
                                        <button type="button" class="secondary" disabled="@busy" @onclick="() => confirmDelete = null">Keep</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="secondary" aria-label="@($"Delete {entry.Name}")" @onclick="() => confirmDelete = entry.Id">Delete</button>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="card" aria-labelledby="add-food-title">
            <h2 id="add-food-title">Add food</h2>
            <div class="field">
                <label for="food-meal">Meal</label>
                <select id="food-meal" @bind="meal">
                    @foreach (var mealCode in FoodLog.Meals)
                    {
                        <option value="@mealCode">@MealName(mealCode)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="food-search">Search foods</label>
                <input id="food-search" type="search" value="@query" @oninput="SearchAsync" autocomplete="off" />
            </div>
            <p class="muted small">Search covers your household's foods and recipes, and the USDA catalogue when you're online. A catalogue food you use is copied into your household, so it works offline afterwards.
                <NavLink href="food/recipes" id="recipes-link">Recipes</NavLink></p>
            @if (results.Length > 0)
            {
                <p class="muted small">@(string.IsNullOrWhiteSpace(query) ? "Recently logged" : "Matching foods")</p>
                <ul class="measurement-list" id="food-results">
                    @foreach (var row in results)
                    {
                        <li class="measurement">
                            <span class="measurement-text"><span>@row.Name@(row.Brand is null ? "" : $" ({row.Brand})")</span>
                                <span class="muted small">@Per100Text(row)</span></span>
                            <button type="button" class="secondary" aria-label="@($"Choose {row.Name}")" @onclick="() => ChooseAsync(row.Id)">Choose</button>
                        </li>
                    }
                </ul>
            }
            @if (recipeResults.Length > 0)
            {
                <p class="muted small">@(string.IsNullOrWhiteSpace(query) ? "Your recipes" : "Matching recipes")</p>
                <ul class="measurement-list" id="recipe-results">
                    @foreach (var recipe in recipeResults)
                    {
                        <li class="measurement">
                            <span class="measurement-text"><span>@recipe.Name</span>
                                <span class="muted small">Recipe · @ServingsText(recipe.Servings)</span></span>
                            <button type="button" class="secondary" aria-label="@($"Choose recipe {recipe.Name}")" @onclick="() => ChooseRecipeAsync(recipe.Id)">Choose</button>
                        </li>
                    }
                </ul>
            }
            @if (CatalogueShown.Count > 0)
            {
                <p class="muted small">From the USDA catalogue</p>
                <ul class="measurement-list" id="catalogue-results">
                    @foreach (var row in CatalogueShown)
                    {
                        <li class="measurement">
                            <span class="measurement-text"><span>@row.Name@(row.Brand is null ? "" : $" ({row.Brand})")</span>
                                <span class="muted small">@Per100Text(row) · USDA</span></span>
                            <button type="button" class="secondary" disabled="@busy" aria-label="@($"Use {row.Name} from the USDA catalogue")" @onclick="() => UseCatalogueAsync(row)">Use</button>
                        </li>
                    }
                </ul>
            }
            @if (catalogueNote is not null)
            {
                <p class="muted small" id="catalogue-note">@catalogueNote</p>
            }
            @if (results.Length == 0 && recipeResults.Length == 0 && CatalogueShown.Count == 0 && catalogueSearched && !string.IsNullOrWhiteSpace(query))
            {
                <p class="muted">Nothing matches. Add it below, or use quick add.</p>
            }

            @if (chosen is not null)
            {
                <form class="form" id="log-food-form" @onsubmit="LogAsync" @onsubmit:preventDefault>
                    <p><strong>@chosen.Name</strong>@(chosen.Brand is null ? "" : $" ({chosen.Brand})")</p>
                    <div class="field">
                        <label for="food-amount">Amount</label>
                        <div class="inline">
                            <input id="food-amount" inputmode="decimal" @bind="amount" @bind:event="oninput" />
                            <select id="food-unit" aria-label="Amount unit" @bind="unit">
                                @foreach (var portion in chosen.Portions)
                                {
                                    <option value="@("portion:" + portion.Name)">× @portion.Name</option>
                                }
                                @foreach (var unitCode in FoodLog.UnitsFor(chosen.Basis))
                                {
                                    <option value="@unitCode">@UnitName(unitCode)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="muted" id="food-preview">@PreviewText()</p>
                    <div class="inline">
                        <button type="submit" class="primary" id="log-food" disabled="@busy">Log food</button>
                        <button type="button" class="secondary" @onclick="() => chosen = null">Cancel</button>
                    </div>
                </form>
            }
            @if (chosenRecipe is not null)
            {
                <form class="form" id="log-recipe-form" @onsubmit="LogRecipeAsync" @onsubmit:preventDefault>
                    <p><strong>@chosenRecipe.Recipe.Name</strong> · recipe, @ServingsText(chosenRecipe.Recipe.Servings)</p>
                    @if (!chosenRecipe.Complete)
                    {
                        <p class="muted">Some of this recipe's ingredients haven't synced to this device yet, so it can't be logged here.</p>
                    }
                    <div class="field">
                        <label for="recipe-amount">Amount</label>
                        <div class="inline">
                            <input id="recipe-amount" inputmode="decimal" @bind="recipeAmount" @bind:event="oninput" />
                            <select id="recipe-unit" aria-label="Recipe amount unit" @bind="recipeUnit">
                                @foreach (var unitCode in FoodLog.RecipeUnits(chosenRecipe.Nutrition()?.Per100g is not null))
                                {
                                    <option value="@unitCode">@(unitCode == "serving" ? "servings" : UnitName(unitCode))</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p class="muted" id="recipe-preview">@RecipePreviewText()</p>
                    <div class="inline">
                        <button type="submit" class="primary" id="log-recipe" disabled="@(busy || !chosenRecipe.Complete)">Log recipe</button>
                        <button type="button" class="secondary" @onclick="() => chosenRecipe = null">Cancel</button>
                    </div>
                </form>
            }
        </section>

        <section class="card" aria-labelledby="quick-add-title">
            <h2 id="quick-add-title">Quick add</h2>
            <p class="muted small">Calories or macros without a food, in the meal chosen above. Leave a value blank if you don't know it.</p>
            <form class="form" id="quick-add-form" @onsubmit="QuickAddAsync" @onsubmit:preventDefault>
                <div class="field"><label for="quick-name">Name (optional)</label><input id="quick-name" @bind="quickName" @bind:event="oninput" /></div>
                <div class="field"><label for="quick-energy">Energy (@EnergyUnitName)</label><input id="quick-energy" inputmode="decimal" @bind="quickEnergy" @bind:event="oninput" /></div>
                <div class="field"><label for="quick-protein">Protein (g)</label><input id="quick-protein" inputmode="decimal" @bind="quickProtein" @bind:event="oninput" /></div>
                <div class="field"><label for="quick-carbohydrate">Carbohydrate (g)</label><input id="quick-carbohydrate" inputmode="decimal" @bind="quickCarbohydrate" @bind:event="oninput" /></div>
                <div class="field"><label for="quick-fat">Fat (g)</label><input id="quick-fat" inputmode="decimal" @bind="quickFat" @bind:event="oninput" /></div>
                <button type="submit" class="primary" id="quick-add" disabled="@busy">Quick add</button>
            </form>
        </section>

        <section class="card" aria-labelledby="new-food-title">
            <h2 id="new-food-title">New food</h2>
            @if (choicesFailed)
            {
                <p class="muted">Your household's foods couldn't be read on this device.</p>
            }
            else if (households.Length == 0)
            {
                <p class="muted">Foods are shared with your household. Your household hasn't synced to this device yet.</p>
            }
            else
            {
                <p class="muted small">Copy the values from the label. They can be for 100 g or ml, or for one serving; the app stores them per 100.</p>
                <form class="form" id="new-food-form" @onsubmit="SaveFoodAsync" @onsubmit:preventDefault>
                    @if (households.Length > 1)
                    {
                        <div class="field"><label for="new-food-household">Household</label><select id="new-food-household" @bind="householdId">
                            @foreach (var household in households) { <option value="@household.Id">@household.Name</option> }
                        </select></div>
                    }
                    <div class="field"><label for="new-food-name">Name</label><input id="new-food-name" @bind="foodName" @bind:event="oninput" /></div>
                    <div class="field"><label for="new-food-brand">Brand (optional)</label><input id="new-food-brand" @bind="foodBrand" @bind:event="oninput" /></div>
                    <div class="field">
                        <label for="new-food-per">Values are for</label>
                        <div class="inline">
                            <input id="new-food-per" inputmode="decimal" @bind="foodPer" @bind:event="oninput" />
                            <select id="new-food-basis" aria-label="Measured by" @bind="foodBasis">
                                <option value="g">g (by weight)</option>
                                <option value="ml">ml (by volume)</option>
                            </select>
                        </div>
                    </div>
                    <div class="field"><label for="new-food-portion">Name that amount as a portion (optional, such as "1 slice")</label><input id="new-food-portion" @bind="foodPortion" @bind:event="oninput" /></div>
                    <div class="field"><label for="new-food-energy">Energy (@EnergyUnitName)</label><input id="new-food-energy" inputmode="decimal" @bind="foodEnergy" @bind:event="oninput" /></div>
                    <div class="field"><label for="new-food-protein">Protein (g)</label><input id="new-food-protein" inputmode="decimal" @bind="foodProtein" @bind:event="oninput" /></div>
                    <div class="field"><label for="new-food-carbohydrate">Carbohydrate (g)</label><input id="new-food-carbohydrate" inputmode="decimal" @bind="foodCarbohydrate" @bind:event="oninput" /></div>
                    <div class="field"><label for="new-food-fat">Fat (g)</label><input id="new-food-fat" inputmode="decimal" @bind="foodFat" @bind:event="oninput" /></div>
                    <button type="submit" class="primary" id="save-food" disabled="@busy">Save food</button>
                </form>
            }
        </section>
        <p class="muted small">Everything is saved on this device first and syncs when you're online.</p>
    }
</div>

@code {
    private string? watchedProfile, error, status, confirmDelete;
    private CancellationTokenSource? watch, choicesWatch;
    private DateOnly date;
    private bool loaded, busy, readFailed, choicesFailed;

    // A read failure's alert, which only a later successful read of the same thing clears: any other error answers the
    // user's last tap and stays until their next one.
    private const string DayReadFailed = "Couldn't read your food log on this device. Leave this tab and come back to try again.";
    private const string ChoicesReadFailed = "Couldn't read your household's foods on this device. Leave this tab and come back to try again.";
    private const string SearchFailed = "Couldn't search your household's foods on this device. Try again.";

    // Bumped whenever the screen starts following another profile (or none). Work that started earlier checks it after
    // each await, so nothing it reads or saves lands on the next profile's screen.
    private int generation, runGeneration;
    private FoodLogEntryRow[] entries = [];
    private NutrientTotal total = NutrientTotal.Empty;

    /// <summary>Nothing logged is 0 of everything, for the targets; null while the day is loading or unreadable.</summary>
    private static readonly NutrientTotal Nothing =
        new(NutrientAmounts.Create([.. Nutrient.Macros.Select(n => (n, 0.0))]), System.Collections.Frozen.FrozenSet<string>.Empty);

    private NutrientTotal? DayTotal => !loaded || readFailed ? null : entries.Length == 0 ? Nothing : total;
    private string meal = "breakfast", query = "", amount = "", unit = "";
    private FoodRow[] results = [];
    private LoggableFood? chosen;
    private RecipeRow[] recipeResults = [];
    private RecipeDetail? chosenRecipe;
    private string recipeAmount = "1", recipeUnit = "serving";
    private string quickName = "", quickEnergy = "", quickProtein = "", quickCarbohydrate = "", quickFat = "";
    private WorkoutService.HouseholdChoice[] households = [];

    // The catalogue's answer for the current query, and a line about it when it couldn't be searched.
    private FoodRow[] catalogueResults = [];
    private string? catalogueNote;
    private bool catalogueSearched;

    /// <summary>Catalogue matches, less those a household on this device already has a copy of (shown with its foods).</summary>
    private IReadOnlyList<FoodRow> CatalogueShown => [.. catalogueResults.Where(row => !households.Any(h =>
        Guid.TryParse(h.Id, out var household) && Guid.TryParse(row.Id, out var food)
        && results.Any(r => r.Id == FoodCopy.IdFor(household, food).ToString("D"))))];
    private string householdId = "", foodName = "", foodBrand = "", foodPer = "100", foodBasis = "g", foodPortion = "";
    private string foodEnergy = "", foodProtein = "", foodCarbohydrate = "", foodFat = "";

    protected override void OnInitialized()
    {
        Profiles.Changed += ProfileChanged;
        Follow();
    }

    private void ProfileChanged() => _ = InvokeAsync(() =>
    {
        if (Foods.ProfileId == watchedProfile)
        {
            StateHasChanged();
        }
        else
        {
            Follow();
            StateHasChanged();
        }
    });

    /// <summary>Follows the signed-in profile: nothing of a previous profile's stays on screen.</summary>
    private void Follow()
    {
        var profileId = Foods.ProfileId;
        if (profileId == watchedProfile)
        {
            return;
        }

        StopWatching();
        StopWatchingChoices();
        generation++;
        watchedProfile = profileId;
        choicesFailed = false;
        error = status = confirmDelete = null;
        entries = []; total = NutrientTotal.Empty; results = []; chosen = null; households = [];
        catalogueResults = []; catalogueNote = null; catalogueSearched = false;
        recipeResults = []; chosenRecipe = null;
        query = amount = quickName = quickEnergy = quickProtein = quickCarbohydrate = quickFat = "";
        ClearNewFood();
        if (profileId is null)
        {
            return;
        }

        date = Foods.Today;
        meal = Foods.Hour switch { < 11 => "breakfast", < 16 => "lunch", < 21 => "dinner", _ => "snack" };
        WatchDay();
        WatchChoices();
    }

    /// <summary>Reloads the households and foods on offer whenever they change, here or synced from another device.</summary>
    private void WatchChoices()
    {
        var started = generation;
        choicesWatch = new CancellationTokenSource();
        var token = choicesWatch.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var _ in Foods.WatchChoices(token))
                {
                    await InvokeAsync(async () =>
                    {
                        if (!token.IsCancellationRequested && started == generation) await LoadChoicesAsync();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception e) when (e is not ObjectDisposedException)
            {
                LogReadFailed(Logger, "household foods", e.GetType().Name);
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested || started != generation) return;
                    choicesFailed = true;
                    error = ChoicesReadFailed;
                    StateHasChanged();
                });
            }
        }, CancellationToken.None);
    }

    private void WatchDay()
    {
        StopWatching();
        loaded = readFailed = false;
        confirmDelete = null;
        // Nothing of the previous day stays on screen (or deletable) while this one loads.
        entries = [];
        total = NutrientTotal.Empty;
        if (error == DayReadFailed) error = null;
        var profile = watchedProfile;
        var day = date;
        watch = new CancellationTokenSource();
        var token = watch.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var rows in Foods.WatchDay(day, token))
                {
                    await InvokeAsync(() =>
                    {
                        if (token.IsCancellationRequested || profile != Foods.ProfileId) return;
                        entries = rows;
                        total = FoodLog.Total(rows);
                        loaded = true;
                        if (error == DayReadFailed) error = null;
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException)
            {
            }
            catch (Exception e) when (e is not ObjectDisposedException)
            {
                LogReadFailed(Logger, "food log", e.GetType().Name);
                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested) return;
                    // Nothing half-read stays on screen: the day is shown as unreadable, not as loading or as it was.
                    entries = [];
                    total = NutrientTotal.Empty;
                    readFailed = true;
                    error = DayReadFailed;
                    StateHasChanged();
                });
            }
        }, CancellationToken.None);
    }

    private void StopWatching()
    {
        watch?.Cancel();
        watch?.Dispose();
        watch = null;
    }

    private void StopWatchingChoices()
    {
        choicesWatch?.Cancel();
        choicesWatch?.Dispose();
        choicesWatch = null;
    }

    private async Task LoadChoicesAsync()
    {
        var started = generation;
        var asked = query;
        try
        {
            var nextHouseholds = await Foods.HouseholdsAsync();
            var nextResults = string.IsNullOrWhiteSpace(asked) ? await Foods.RecentAsync() : await Foods.SearchAsync(asked);
            var nextRecipes = await Foods.SearchRecipesAsync(asked);
            if (started != generation) return;
            households = nextHouseholds;
            // Matches for text the user has since changed stay out: the search for the new text owns the list.
            if (asked == query) (results, recipeResults) = (nextResults, nextRecipes);
            choicesFailed = false;
            if (error == ChoicesReadFailed) error = null;
            if (!households.Any(h => h.Id == householdId)) householdId = households.FirstOrDefault()?.Id ?? "";
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            // A read that started for an earlier profile doesn't matter any more; Follow cleared the screen.
            if (started != generation) return;
            LogReadFailed(Logger, "household foods", e.GetType().Name);
            choicesFailed = true;
            error = ChoicesReadFailed;
        }

        StateHasChanged();
    }

    private async Task MoveAsync(int days)
    {
        date = date.AddDays(days);
        status = null;
        WatchDay();
        await Task.CompletedTask;
    }

    private Task DateChangedAsync(ChangeEventArgs e)
    {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var picked) && picked != date)
        {
            return MoveAsync(picked.DayNumber - date.DayNumber);
        }

        return Task.CompletedTask;
    }

    private async Task SearchAsync(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        var asked = query;
        var started = generation;
        catalogueResults = [];
        catalogueNote = null;
        catalogueSearched = false;
        try
        {
            var found = string.IsNullOrWhiteSpace(asked) ? await Foods.RecentAsync() : await Foods.SearchAsync(asked);
            var foundRecipes = await Foods.SearchRecipesAsync(asked);
            if (asked != query || started != generation) return;
            (results, recipeResults) = (found, foundRecipes);
            if (error == SearchFailed) error = null;
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            // Only the latest search speaks: an older one failing late leaves newer matches alone.
            if (asked != query || started != generation) return;
            LogReadFailed(Logger, "food search", x.GetType().Name);
            results = [];
            recipeResults = [];
            error = SearchFailed;
        }

        await SearchCatalogueAsync(asked, started);
    }

    /// <summary>
    /// The online catalogue, after the household's own foods are on screen, so a slow or failed request never holds
    /// them up. A catalogue that can't be searched says so in a line, not an alert: the household's foods still work.
    /// </summary>
    private async Task SearchCatalogueAsync(string asked, int started)
    {
        if (asked.Trim().Length < PostgrestCatalogueSearch.MinimumQueryLength)
        {
            catalogueSearched = true;
            return;
        }

        StateHasChanged();
        CatalogueSearchResult answer;
        try
        {
            answer = await Foods.SearchCatalogueAsync(asked);
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            LogReadFailed(Logger, "catalogue search", x.GetType().Name);
            answer = CatalogueSearchResult.Of(CatalogueSearchStatus.Unavailable);
        }

        if (asked != query || started != generation) return;
        catalogueSearched = true;
        catalogueResults = [.. answer.Foods];
        catalogueNote = answer.Status switch
        {
            CatalogueSearchStatus.SignedOut => "Sign in again to search the USDA catalogue. Your household's foods are searched as usual.",
            CatalogueSearchStatus.Unavailable => "The USDA catalogue couldn't be searched, so you may be offline. Your household's foods are searched as usual.",
            _ => null,
        };
    }

    /// <summary>Copies a catalogue food into the household (or reuses the copy there) and chooses it for logging.</summary>
    private async Task UseCatalogueAsync(FoodRow row)
    {
        if (busy) return;
        error = null;
        var started = generation;
        var household = households.Any(h => h.Id == householdId) ? householdId : households.FirstOrDefault()?.Id;
        if (household is null)
        {
            error = "Your household hasn't synced to this device yet, so catalogue foods can't be added to it.";
            return;
        }

        busy = true;
        string id;
        try
        {
            id = await Foods.CopyFromCatalogueAsync(household, row);
        }
        catch (Exception x) when (x is ArgumentException or InvalidOperationException)
        {
            if (started == generation) error = "That catalogue food couldn't be added to your household on this device.";
            return;
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            if (started != generation) return;
            LogSaveFailed(Logger, x.GetType().Name);
            error = "That catalogue food couldn't be added to your household on this device. Try again.";
            return;
        }
        finally
        {
            busy = false;
        }

        if (started != generation) return;
        await ChooseAsync(id);
        if (started != generation) return;
        try
        {
            // Show the copy with the household's foods, where later searches find it, offline too.
            var asked = query;
            var found = string.IsNullOrWhiteSpace(asked) ? await Foods.RecentAsync() : await Foods.SearchAsync(asked);
            if (asked == query && started == generation) results = found;
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            if (started == generation) LogReadFailed(Logger, "food search", x.GetType().Name);
        }
    }

    private async Task ChooseAsync(string id)
    {
        error = null;
        var started = generation;
        FoodRow? row;
        try
        {
            row = await Foods.FoodAsync(id);
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            if (started != generation) return;
            LogReadFailed(Logger, "food", x.GetType().Name);
            error = "Couldn't read that food on this device. Try again.";
            return;
        }

        // Chosen for an earlier profile: the next one's form stays as Follow left it.
        if (started != generation) return;
        chosenRecipe = null;
        chosen = row?.ToFood();
        if (chosen is null)
        {
            error = "That food is no longer on this device.";
            return;
        }

        unit = chosen.Portions.Count > 0
            ? "portion:" + chosen.Portions[0].Name
            : chosen.Basis == FoodBasis.Mass ? UnitPrefOptions.FoodMass.ToCode(Foods.UnitPrefs.FoodMass) : UnitPrefOptions.Volume.ToCode(Foods.UnitPrefs.Volume);
        amount = chosen.Portions.Count > 0 ? "1" : "";
    }

    private async Task ChooseRecipeAsync(string id)
    {
        error = null;
        var started = generation;
        RecipeDetail? recipe;
        try
        {
            recipe = await Foods.RecipeAsync(id);
        }
        catch (Exception x) when (x is not OperationCanceledException)
        {
            if (started != generation) return;
            LogReadFailed(Logger, "recipe", x.GetType().Name);
            error = "Couldn't read that recipe on this device. Try again.";
            return;
        }

        if (started != generation) return;
        if (recipe is null)
        {
            error = "That recipe is no longer on this device.";
            return;
        }

        chosen = null;
        chosenRecipe = recipe;
        recipeAmount = "1";
        recipeUnit = "serving";
    }

    private string RecipePreviewText()
    {
        if (chosenRecipe is null || NumberText.Parse(recipeAmount) is not { } quantity || quantity <= 0) return "Enter an amount to see what it holds.";
        try
        {
            var (_, amounts) = FoodLog.ComputeRecipe(chosenRecipe, quantity, recipeUnit);
            return string.Join(" · ", Nutrient.Macros.Select(n => amounts.Amounts[n] is { } v
                ? $"{MacroName(n)} {(amounts.Incomplete.Contains(n.Code) ? "at least " : "")}{(n == Nutrient.Energy ? MetricDisplay.Energy(v, Foods.UnitPrefs.Energy) : MetricDisplay.Format(v, "g"))}"
                : $"{MacroName(n)} not listed"));
        }
        catch (Exception e) when (e is ArgumentException or InvalidOperationException)
        {
            return e.Message;
        }
    }

    private Task LogRecipeAsync() => RunAsync(async () =>
    {
        if (chosenRecipe is null) return;
        var quantity = NumberText.Parse(recipeAmount) ?? throw new ArgumentException("Enter the amount as a number.");
        var name = chosenRecipe.Recipe.Name;
        await Foods.LogRecipeAsync(chosenRecipe.Recipe.Id, meal, date, quantity, recipeUnit);
        if (!Current) return;
        chosenRecipe = null;
        status = $"Logged {name} in {MealName(meal).ToLowerInvariant()}. Saved on this device, ready to sync.";
    });

    private static string ServingsText(double servings) =>
        servings == 1 ? "1 serving" : $"{servings.ToString("0.##", CultureInfo.CurrentCulture)} servings";

    private (string? Unit, string? Portion) SplitUnit() =>
        unit.StartsWith("portion:", StringComparison.Ordinal) ? (null, unit["portion:".Length..]) : (unit, null);

    private string PreviewText()
    {
        if (chosen is null || NumberText.Parse(amount) is not { } quantity || quantity <= 0) return "Enter an amount to see what it holds.";
        try
        {
            var (u, portion) = SplitUnit();
            var (_, amounts) = FoodLog.Compute(chosen, quantity, u, portion);
            return string.Join(" · ", Nutrient.Macros.Select(n => amounts[n] is { } v
                ? $"{MacroName(n)} {(n == Nutrient.Energy ? MetricDisplay.Energy(v, Foods.UnitPrefs.Energy) : MetricDisplay.Format(v, "g"))}"
                : $"{MacroName(n)} not listed"));
        }
        catch (ArgumentException e)
        {
            return e.Message;
        }
    }

    private Task LogAsync() => RunAsync(async () =>
    {
        if (chosen is null) return;
        var quantity = NumberText.Parse(amount) ?? throw new ArgumentException("Enter the amount as a number.");
        var (u, portion) = SplitUnit();
        var name = chosen.Name;
        await Foods.LogAsync(chosen.Id, meal, date, quantity, u, portion);
        if (!Current) return;
        chosen = null;
        amount = "";
        status = $"Logged {name} in {MealName(meal).ToLowerInvariant()}. Saved on this device, ready to sync.";
        await LoadChoicesAsync();
    });

    private Task QuickAddAsync() => RunAsync(async () =>
    {
        var energy = Optional(quickEnergy, "energy");
        await Foods.QuickAddAsync(meal, date, quickName, energy is { } e ? ToKcal(e) : null,
            Optional(quickProtein, "protein"), Optional(quickCarbohydrate, "carbohydrate"), Optional(quickFat, "fat"));
        if (!Current) return;
        quickName = quickEnergy = quickProtein = quickCarbohydrate = quickFat = "";
        status = $"Added to {MealName(meal).ToLowerInvariant()}. Saved on this device, ready to sync.";
    });

    private Task SaveFoodAsync() => RunAsync(async () =>
    {
        if (string.IsNullOrEmpty(householdId)) throw new ArgumentException("Choose a household first.");
        var per = NumberText.Parse(foodPer) ?? throw new ArgumentException("Enter the amount the values are for as a number.");
        FoodBases.TryParse(foodBasis, out var basis);
        var energy = Optional(foodEnergy, "energy");
        PortionInput[] portions = string.IsNullOrWhiteSpace(foodPortion) ? [] : [new PortionInput(foodPortion.Trim(), per)];
        var input = new FoodInput(foodName, string.IsNullOrWhiteSpace(foodBrand) ? null : foodBrand, basis, per,
            energy is { } e ? ToKcal(e) : null, Optional(foodProtein, "protein"), Optional(foodCarbohydrate, "carbohydrate"), Optional(foodFat, "fat"), portions);
        var id = await Foods.AddFoodAsync(householdId, input);
        if (!Current) return;
        var name = input.Name.Trim();
        ClearNewFood();
        await ChooseAsync(id);
        if (!Current) return;
        status = $"Saved {name} for your household. Enter an amount above to log it.";
    });

    private Task DeleteAsync(string id) => RunAsync(async () =>
    {
        await Foods.DeleteAsync(id);
        if (!Current) return;
        confirmDelete = null;
        status = "Entry deleted.";
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (busy || watchedProfile is null || watchedProfile != Foods.ProfileId) return;
        busy = true;
        runGeneration = generation;
        error = status = null;
        try
        {
            await action();
        }
        catch (ValidationException e) when (Current)
        {
            error = string.Join(" ", e.Errors.Select(x => x.ErrorMessage).Distinct(StringComparer.Ordinal));
        }
        catch (Exception e) when (Current && e is ArgumentException or InvalidOperationException)
        {
            error = e.Message;
        }
        catch (Exception e) when (Current && e is not OperationCanceledException)
        {
            LogSaveFailed(Logger, e.GetType().Name);
            error = "Couldn't save on this device. Try again.";
        }
        catch (Exception e) when (!Current && e is not OperationCanceledException)
        {
            // Started for an earlier profile: its outcome isn't the current profile's to see.
        }
        finally
        {
            busy = false;
        }
    }

    private void ClearNewFood()
    {
        foodName = foodBrand = foodPortion = foodEnergy = foodProtein = foodCarbohydrate = foodFat = "";
        foodPer = "100";
        foodBasis = "g";
    }

    /// <summary>A blank field is unknown; anything else must be a number.</summary>
    private static double? Optional(string text, string what) =>
        string.IsNullOrWhiteSpace(text) ? null : NumberText.Parse(text) ?? throw new ArgumentException($"Enter {what} as a number, or leave it blank.");

    /// <summary>An energy typed in the user's unit, in kcal.</summary>
    private double ToKcal(double value) =>
        Foods.UnitPrefs.Energy == EnergyUnit.Kilojoule ? Conversion.Convert(value, Unit.Kilojoule, Unit.Kilocalorie) : value;

    private string EnergyUnitName => Foods.UnitPrefs.Energy == EnergyUnit.Kilojoule ? "kJ" : "kcal";

    private string EnergyText(NutrientTotal sum) =>
        sum.Amounts[Nutrient.Energy] is { } kcal
            ? (sum.Incomplete.Contains(Nutrient.Energy.Code) ? "at least " : "") + MetricDisplay.Energy(kcal, Foods.UnitPrefs.Energy)
            : "energy not listed";

    private string TotalText(Nutrient nutrient)
    {
        if (nutrient == Nutrient.Energy) return EnergyText(total);
        return total.Amounts[nutrient] is { } grams
            ? (total.Incomplete.Contains(nutrient.Code) ? "at least " : "") + MetricDisplay.Format(grams, "g")
            : "not listed";
    }

    private string Per100Text(FoodRow row)
    {
        var basis = row.Basis == "ml" ? "100 ml" : "100 g";
        return row.Energy100 is { } kcal ? $"{MetricDisplay.Energy(kcal, Foods.UnitPrefs.Energy)} per {basis}" : $"energy not listed per {basis}";
    }

    private static string AmountText(FoodLogEntryRow entry)
    {
        if (entry.Quantity is not { } quantity) return entry.EntryMethod == "quick_add" ? "Quick add" : "";
        var number = quantity.ToString("0.##", CultureInfo.CurrentCulture);
        return entry.QuantityUnit switch
        {
            "portion" => $"{number} × {entry.PortionName}",
            "serving" => quantity == 1 ? "1 serving" : $"{number} servings",
            _ => $"{number} {UnitName(entry.QuantityUnit ?? "")}",
        };
    }

    private static string UnitName(string code) => code switch
    {
        "fl_oz" => "fl oz",
        "cup" => "cups",
        "l" => "L",
        _ => code,
    };

    private static string MealName(string code) => code switch
    {
        "breakfast" => "Breakfast",
        "lunch" => "Lunch",
        "dinner" => "Dinner",
        _ => "Snacks",
    };

    private static string MacroName(Nutrient nutrient) => nutrient.Code switch
    {
        "energy" => "Energy",
        "protein" => "Protein",
        "carbohydrate" => "Carbohydrate",
        _ => "Fat",
    };

    /// <summary>Whether the save in progress started for the profile the screen follows now.</summary>
    private bool Current => runGeneration == generation;

    // The kind of read and the exception's type only: never the rows, food names or amounts. (The logging source
    // generator can't see Razor's generated class, so the messages are defined here.)
    private static readonly Action<ILogger, string, string, Exception?> ReadFailedMessage =
        LoggerMessage.Define<string, string>(LogLevel.Warning, new EventId(1, "FoodReadFailed"), "The Food tab couldn't read the {What}: {Error}");

    private static readonly Action<ILogger, string, Exception?> SaveFailedMessage =
        LoggerMessage.Define<string>(LogLevel.Warning, new EventId(2, "FoodSaveFailed"), "The Food tab couldn't save: {Error}");

    private static void LogReadFailed(ILogger logger, string what, string error) => ReadFailedMessage(logger, what, error, null);

    private static void LogSaveFailed(ILogger logger, string error) => SaveFailedMessage(logger, error, null);

    public void Dispose()
    {
        Profiles.Changed -= ProfileChanged;
        StopWatching();
        StopWatchingChoices();
    }
}
