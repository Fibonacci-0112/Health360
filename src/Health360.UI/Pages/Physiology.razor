@page "/body/physiology"
@using Health360.Domain.Physiology
@implements IDisposable
@inject BodyData Data
@inject ProfileService Profiles

@* The physiology profile (PLAN.md §2.8): measured values first, estimates otherwise, and always which one is in
   use. Everything shown is computed by Health360.Domain from the entered values, so entering or deleting one
   changes it at once. *@
<div class="page">
    <div class="page-head">
        <h1>Physiology profile</h1>
        <NavLink class="top-link" href="body">Body</NavLink>
    </div>
    <p class="muted">
        Values you enter from a lab, a field test or a device are used first. Anything missing is estimated from a
        published equation where one exists, and labelled as an estimate. This is wellness information, not a diagnosis.
    </p>

    @if (Data.Failed)
    {
        <p class="error" role="alert">Couldn't read your measurements on this device. Leave this screen and come back to try again.</p>
    }

    @if (Data.Measurements is null || profile is null)
    {
        <p class="muted" role="status">Loading your profile</p>
    }
    else
    {
        var prefs = Profiles.UnitPrefs;
        <section class="card" aria-labelledby="values-title">
            <h2 id="values-title">In use now</h2>
            <dl class="values">
                @Row("Resting metabolic rate", MetricCodes.Rmr, profile.Rmr, v => MetricDisplay.Energy(v, prefs.Energy) + "/day", RmrMissing())
                <div class="value-row">
                    <dt>Maintenance energy</dt>
                    <dd>
                        @if (profile.Maintenance is { } maintenance)
                        {
                            <span class="strong">@MetricDisplay.Energy(maintenance.Kcal, prefs.Energy)/day</span>
                            <span class="badge-estimate">Estimate</span>
                            <span class="muted small">
                                RMR @MetricDisplay.Energy(maintenance.Rmr.Value, prefs.Energy) (@Origin(maintenance.Rmr)) × @MetricDisplay.Number(maintenance.Pal, 3)
                                (@ActivityName(maintenance.Level), FAO/WHO/UNU 2004)
                            </span>
                        }
                        else
                        {
                            <span class="muted">@(profile.Rmr is null ? "Needs a resting metabolic rate." : "Needs your activity level (Settings).")</span>
                        }
                    </dd>
                </div>
                @Row("Max heart rate", MetricCodes.MaxHr, profile.MaxHr, v => MetricDisplay.Format(v, "bpm"), MaxHrMissing())
                @Row("Resting heart rate", MetricCodes.RestingHr, profile.RestingHr, v => MetricDisplay.Format(v, "bpm"),
                    "Not estimated. Enter morning readings; without one, zones use % of max heart rate.")
                @Row("Lactate threshold HR", MetricCodes.Lthr, profile.Lthr, v => MetricDisplay.Format(v, "bpm"),
                    "Enter a lab test or a 30-minute time trial (average HR of the last 20 minutes).")
                @Row("VO₂max", MetricCodes.Vo2Max, profile.Vo2Max, v => MetricDisplay.Format(v, "ml/kg/min"),
                    Vo2MaxMissing())
                @Row(ThresholdName(profile.LowerThreshold, "LT1"), profile.LowerThreshold?.MetricCode ?? MetricCodes.Lt1Hr, profile.LowerThreshold, v => MetricDisplay.Format(v, "bpm"),
                    "From a lab lactate or gas-exchange test. Not estimated.")
                @Row(ThresholdName(profile.UpperThreshold, "LT2"), profile.UpperThreshold?.MetricCode ?? MetricCodes.Lt2Hr, profile.UpperThreshold, v => MetricDisplay.Format(v, "bpm"),
                    "From a lab lactate or gas-exchange test. Not estimated.")
                @foreach (var code in InactiveThresholdPins())
                {
                    var name = MetricDisplay.Name(code);
                    @* The screen shows one threshold pair (lactate first); a pin on the other pair would otherwise be
                       invisible, yet come back into use if the shown pair's values were deleted. *@
                    <div class="value-row">
                        <dt>@name</dt>
                        <dd>
                            <span class="error small">Your choice for @name isn't in use: thresholds now come from the @(code.StartsWith("vt", StringComparison.Ordinal) ? "lactate" : "ventilatory") pair.</span>
                            @PinButton("Clear my choice", $"Clear your choice for {name}", () => Data.UnpinAsync(code))
                        </dd>
                    </div>
                }
                @Row("Body fat", MetricCodes.BodyFatPercent, profile.BodyFat, v => MetricDisplay.Format(v, "%"), "Enter a DEXA, scale or other value on the Body tab.")
                <div class="value-row">
                    <dt>Fat-free mass</dt>
                    <dd>
                        @if (profile.FatFreeMassKg is { } ffm)
                        {
                            <span class="strong">@MetricDisplay.BodyWeight(ffm, prefs.BodyWeight)</span>
                            <span class="muted small">Trend weight × (1 − body fat). As measured or estimated as the body fat it comes from.</span>
                        }
                        else
                        {
                            <span class="muted">Needs a weigh-in and a body-fat value.</span>
                        }
                    </dd>
                </div>
            </dl>
            <p class="muted small">
                To use a value other than the one chosen automatically, open "Other values on file" and choose it. It stays
                in use, even when newer values are entered, until you go back to the best value.
            </p>
            @if (pinError is not null)
            {
                <p class="error" role="alert">@pinError</p>
            }
        </section>

        <section class="card" aria-labelledby="zones-title">
            <h2 id="zones-title">Heart-rate zones</h2>
            <span class="label" id="zones-sport">Sport</span>
            <ChoiceGroup LabelledBy="zones-sport" Options="SportCodes" Labels="SportNames" Value="@sport" ValueChanged="code => sport = code ?? sport" />
            @if (Zones() is { } zones)
            {
                <p class="muted small">
                    @zones.Method. @ZoneBasisText(zones)
                </p>
                <table class="zones">
                    <thead>
                        <tr><th scope="col">Zone</th><th scope="col">From</th><th scope="col">Up to</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var zone in zones.Zones)
                        {
                            <tr>
                                <th scope="row">@zone.Name</th>
                                <td>@MetricDisplay.Format(zone.LowerBpm, "bpm")</td>
                                <td>@(zone.UpperBpm is { } upper ? MetricDisplay.Format(upper, "bpm") : "and above")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="muted">@ZonesMissing()</p>
            }
        </section>

        <section class="card" aria-labelledby="activity-title">
            <h2 id="activity-title">Physical activity rating</h2>
            <p class="muted small">
                Without a resting heart rate, VO₂max can be estimated from your age, sex, BMI or body fat, and these answers
                (Jackson et al., 1990). The questions and their scoring (0–7) are from the NHANES Cardiovascular Fitness
                Procedures Manual, Appendix E. Think about your usual activity over the last month.
            </p>
            @if (profile.Inputs.ActivityRating is { } rating)
            {
                <p>Your rating: <span class="strong">@rating</span> <span class="muted small">(@RatingText(rating))</span></p>
            }
            else
            {
                <p class="muted">Not answered yet, so VO₂max isn't estimated from it.</p>
            }

            <span class="label" id="activity-q1">
                Would you say that you did little or no regular recreation, sport, or physical activity? Or that you
                participated regularly in recreation or work requiring modest physical activity? Or that you participated
                regularly in heavy physical exercise?
            </span>
            <ChoiceGroup LabelledBy="activity-q1" Disabled="savingRating" Options="RegularCodes" Labels="RegularNames" Value="@regular"
                         ValueChanged="code => { regular = code; followUp = null; }" />
            <p class="muted small">
                Modest: walking, calisthenics, bowling, weight lifting, yard work. Heavy: jogging, swimming, cycling, rowing,
                tennis, basketball.
            </p>
            @if (FollowUp() is var (question, options, labels))
            {
                <span class="label" id="activity-q2">@question</span>
                <ChoiceGroup LabelledBy="activity-q2" Disabled="savingRating" Options="options" Labels="labels" Value="@followUp" ValueChanged="code => followUp = code" />
            }

            <div class="choices">
                <button type="button" class="primary" disabled="@(ScoredRating() is null || savingRating)" @onclick="() => SaveRatingAsync(ScoredRating())">
                    Save answers
                </button>
                @if (profile.Inputs.ActivityRating is not null)
                {
                    <button type="button" class="secondary" disabled="@savingRating" @onclick="() => SaveRatingAsync(null)">Clear my rating</button>
                }
            </div>
            @if (ratingError is not null)
            {
                <p class="error" role="alert">@ratingError</p>
            }
        </section>

        <section class="card" aria-labelledby="medication-title">
            <h2 id="medication-title">Medication</h2>
            <label class="check">
                @* Keyed so a failed save re-creates the box from the stored value instead of keeping the click. *@
                <input @key="medicationRender" type="checkbox" checked="@profile.Inputs.TakesHeartRateLoweringMedication" disabled="@savingMedication"
                       @onchange="SetMedicationAsync" />
                I take medication that lowers my heart rate (a beta blocker, for example)
            </label>
            <p class="muted small">
                When this is on, nothing is worked out from age-predicted max heart rate. Zones then need a measured max heart rate.
            </p>
            @if (medicationError is not null)
            {
                <p class="error" role="alert">@medicationError</p>
            }
        </section>

        <MeasurementForm IdPrefix="add-physiology" Title="Add a test result or value" Metrics="PhysiologyMetrics" DefaultSource="lab" />

        <MeasurementList IdPrefix="physiology" Title="Entered" Rows="PhysiologyRows" />
    }
</div>

@code {
    private static readonly IReadOnlyList<string> PhysiologyMetrics =
    [
        MetricCodes.Rmr, MetricCodes.MaxHr, MetricCodes.RestingHr, MetricCodes.Lthr, MetricCodes.Vo2Max, "vo2max_absolute",
        MetricCodes.Lt1Hr, MetricCodes.Lt2Hr, MetricCodes.Vt1Hr, MetricCodes.Vt2Hr,
        "ftp", "lt1_power", "lt2_power", "vt1_power", "vt2_power",
        "threshold_pace", "lt1_pace", "lt2_pace", "vt1_pace", "vt2_pace",
        "fat_mass_arms", "fat_mass_legs", "fat_mass_trunk", "lean_mass_arms", "lean_mass_legs", "lean_mass_trunk",
        "bone_mineral_content", "bmd", "bmd_t_score", "bmd_z_score", "vat_mass", "android_fat_pct", "gynoid_fat_pct", "almi",
    ];

    private static readonly IReadOnlyList<string> SportCodes = ["run", "bike", "swim", "row", "other"];

    private static readonly IReadOnlyDictionary<string, string> SportNames = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["run"] = "Run",
        ["bike"] = "Bike",
        ["swim"] = "Swim",
        ["row"] = "Row",
        ["other"] = "Other",
    };

    private PhysiologyProfile? profile;
    private string sport = "run";
    private bool savingPin;
    private string? pinError;
    private bool savingMedication;
    private string? medicationError;
    private int medicationRender;

    private IReadOnlyList<Health360.LocalDb.MeasurementRow> PhysiologyRows =>
        [.. (Data.Measurements ?? []).Where(r => Data.Definitions.TryGetValue(r.MetricCode, out var d) && d.Category == "physiology")];

    protected override void OnInitialized()
    {
        Data.Changed += Refresh;
        Profiles.Changed += Refresh;
        Data.EnsureWatching();
    }

    protected override void OnParametersSet() => profile = Data.Profile();

    private HeartRateZones? Zones() =>
        profile?.ZonesFor(Enum.GetValues<ZoneSport>().First(s => HeartRateZoneRules.Code(s) == sport));

    private RenderFragment Row(string name, string code, ProfileValue? value, Func<double, string> format, string missing) => __builder =>
    {
        <div class="value-row">
            <dt>@name</dt>
            <dd>
                @if (value is null)
                {
                    <span class="muted">@missing</span>
                    @if (Data.Pins?.ContainsKey(code) == true)
                    {
                        @* The resolver had nothing at all to fall back to; the pin is still stored, so say so. *@
                        <span class="error small">The value you chose is no longer available.</span>
                        @PinButton("Clear my choice", $"Clear your choice for {name}", () => Data.UnpinAsync(code))
                    }
                }
                else
                {
                    var r = value.Resolution;
                    <span class="strong">@format(r.Value)</span>
                    @if (r.IsEstimate)
                    {
                        <span class="badge-estimate">Estimate</span>
                    }
                    @if (value.RetestSuggested)
                    {
                        <span class="badge-retest">Retest?</span>
                    }
                    <span class="muted small">@Origin(r)</span>
                    @if (r.Pinned)
                    {
                        @PinButton("Go back to the best value", $"Go back to the best value for {name}", () => Data.UnpinAsync(code))
                    }
                    @if (r.PinUnavailable)
                    {
                        <span class="error small">The value you chose is no longer available, so the next best is used.</span>
                        @PinButton("Clear my choice", $"Clear your choice for {name}", () => Data.UnpinAsync(code))
                    }
                    @if (r.PassedOver.Count > 0 || r.EstimatePassedOver is not null)
                    {
                        <details class="passed-over">
                            <summary>Other values on file</summary>
                            <ul>
                                @foreach (var other in r.PassedOver)
                                {
                                    var id = other.Id.ToString();
                                    <li>
                                        @format(other.Value): @SourceText(other)
                                        @PinButton("Use this", $"Use {format(other.Value)} ({SourceText(other)}) for {name}", () => Data.PinMeasurementAsync(id))
                                    </li>
                                }
                                @if (r.EstimatePassedOver is { } estimate)
                                {
                                    <li>
                                        @format(estimate.Value): estimate, @estimate.Method
                                        @PinButton("Use this", $"Use the estimate, {format(estimate.Value)}, for {name}", () => Data.PinEstimateAsync(value.MetricCode))
                                    </li>
                                }
                            </ul>
                        </details>
                    }
                }
            </dd>
        </div>
    };

    private static readonly IReadOnlyList<string> ThresholdCodes = [MetricCodes.Lt1Hr, MetricCodes.Lt2Hr, MetricCodes.Vt1Hr, MetricCodes.Vt2Hr];

    /// <summary>Pinned threshold metrics the screen doesn't show a row for, because the other pair is in use.</summary>
    private IEnumerable<string> InactiveThresholdPins()
    {
        var shown = new[]
        {
            profile!.LowerThreshold?.MetricCode ?? MetricCodes.Lt1Hr,
            profile.UpperThreshold?.MetricCode ?? MetricCodes.Lt2Hr,
        };
        return ThresholdCodes.Where(c => !shown.Contains(c) && Data.Pins?.ContainsKey(c) == true);
    }

    private RenderFragment PinButton(string text, string label, Func<Task> save) => __builder =>
    {
        <button type="button" class="secondary compact" aria-label="@label" disabled="@savingPin" @onclick="() => SavePinAsync(save)">@text</button>
    };

    private async Task SavePinAsync(Func<Task> save)
    {
        savingPin = true;
        pinError = null;
        try
        {
            await save();
        }
        catch (Exception failure) when (failure is not OperationCanceledException)
        {
            pinError = "Couldn't save your choice on this device. Please try again.";
        }
        finally
        {
            savingPin = false;
        }
    }

    /// <summary>Where a resolved value came from: "Lab, 1 Mar 2026" or "Mifflin-St Jeor equation, ± 5.35".</summary>
    private static string Origin(Resolution resolution) =>
        (resolution.Measurement is { } measured
            ? SourceText(measured)
            : resolution.Estimate!.StandardError is { } se
                ? $"{resolution.Estimate.Method} equation, standard error ± {MetricDisplay.Number(se, 2)}"
                : $"{resolution.Estimate.Method} equation")
        + (resolution.Pinned ? ", your choice" : "");

    private static string SourceText(Measured measured) =>
        $"{MetricDisplay.SourceName(MeasurementSources.Code(measured.Source))}, {MetricDisplay.Date(measured.MeasuredOn)}";

    private static string ThresholdName(ProfileValue? value, string fallback) =>
        value is null ? $"{fallback} heart rate" : MetricDisplay.Name(value.MetricCode);

    private static string ActivityName(ActivityLevel level) => level switch
    {
        ActivityLevel.Sedentary => "mostly sitting",
        ActivityLevel.Light => "light",
        ActivityLevel.Moderate => "moderate",
        ActivityLevel.Active => "active",
        ActivityLevel.VeryActive => "very active",
        _ => level.ToString(),
    };

    private string RmrMissing() =>
        profile!.WeightKg is null ? "Needs a weigh-in (Body tab), plus your height, birth date and sex (Settings)."
        : "Needs your height, birth date and sex (Settings).";

    private string MaxHrMissing() =>
        profile!.Inputs.TakesHeartRateLoweringMedication
            ? "Not estimated while the medication setting below is on. Enter a measured value."
            : "Needs your birth date (Settings).";

    private string ZoneBasisText(HeartRateZones zones)
    {
        var estimated = zones.Inputs.Where(i => i.IsEstimate).Select(i => i.Estimate!.Method).ToList();
        var basis = zones.Basis switch
        {
            ZoneBasis.Lab => "From your lab thresholds.",
            ZoneBasis.Lthr => "From your lactate threshold heart rate.",
            ZoneBasis.HeartRateReserve => "From your heart rate reserve (max minus resting).",
            _ => "From your max heart rate.",
        };
        return estimated.Count == 0
            ? basis
            : $"{basis} The max heart rate is an estimate ({string.Join(", ", estimated)}; individuals vary by about ±10 bpm), so a measured value would make these more accurate.";
    }

    private string ZonesMissing() =>
        profile!.Inputs.TakesHeartRateLoweringMedication
            ? "Enter a measured max heart rate: with the medication setting on, zones aren't based on an age estimate."
            : "Enter your birth date in Settings, or a measured max heart rate, threshold or lab test.";

    private static readonly IReadOnlyList<string> RegularCodes = ["none", "modest", "heavy"];

    private static readonly IReadOnlyDictionary<string, string> RegularNames = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        ["none"] = "Little or no activity",
        ["modest"] = "Modest activity",
        ["heavy"] = "Heavy exercise",
    };

    private static readonly IReadOnlyDictionary<string, string> ExertionNames = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(DailyExertion.AvoidsWalkingOrExertion)] = "I avoid walking or exertion (always use the elevator, drive whenever possible instead of walking)",
        [nameof(DailyExertion.WalksForPleasure)] = "I walk for pleasure, routinely use stairs, occasionally exercise enough to cause heavy breathing or perspiration",
    };

    private static readonly IReadOnlyDictionary<string, string> ModestNames = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(ModestActivityTime.TenToSixtyMinutes)] = "10 to 60 minutes per week",
        [nameof(ModestActivityTime.MoreThanSixtyMinutes)] = "More than 60 minutes per week",
    };

    private static readonly IReadOnlyDictionary<string, string> HeavyNames = new Dictionary<string, string>(StringComparer.Ordinal)
    {
        [nameof(HeavyActivityTime.LessThanThirtyMinutes)] = "Less than 30 minutes per week",
        [nameof(HeavyActivityTime.ThirtyToSixtyMinutes)] = "30 to 60 minutes per week",
        [nameof(HeavyActivityTime.OneToThreeHours)] = "1 to 3 hours per week",
        [nameof(HeavyActivityTime.MoreThanThreeHours)] = "More than 3 hours per week",
    };

    private string? regular;
    private string? followUp;
    private bool savingRating;
    private string? ratingError;

    private (string Question, IReadOnlyList<string> Options, IReadOnlyDictionary<string, string> Labels)? FollowUp() => regular switch
    {
        "none" => ("Which describes you better?", [.. ExertionNames.Keys], ExertionNames),
        "modest" => ("How much time per week?", [.. ModestNames.Keys], ModestNames),
        "heavy" => ("How much time per week?", [.. HeavyNames.Keys], HeavyNames),
        _ => null,
    };

    /// <summary>The PA-R code for the answers given so far, scored by Health360.Domain; null until both are answered.</summary>
    private int? ScoredRating() => (regular, followUp) switch
    {
        ("none", { } f) => PhysicalActivityRating.Code(Enum.Parse<DailyExertion>(f)),
        ("modest", { } f) => PhysicalActivityRating.Code(Enum.Parse<ModestActivityTime>(f)),
        ("heavy", { } f) => PhysicalActivityRating.Code(Enum.Parse<HeavyActivityTime>(f)),
        _ => null,
    };

    /// <summary>The answers a stored code stands for (NHANES Appendix E, p. E-3).</summary>
    private static string RatingText(int rating) => rating switch
    {
        0 => "little or no activity, avoids walking or exertion",
        1 => "little or no activity, walks for pleasure and uses stairs",
        2 => "modest activity, 10–60 minutes a week",
        3 => "modest activity, more than 60 minutes a week",
        4 => "heavy exercise, less than 30 minutes a week",
        5 => "heavy exercise, 30–60 minutes a week",
        6 => "heavy exercise, 1–3 hours a week",
        _ => "heavy exercise, more than 3 hours a week",
    };

    private string Vo2MaxMissing() =>
        profile!.RestingHr is not null
            ? "Enter a lab or field test result. The estimate that uses a resting heart rate isn't available yet."
            : profile.Inputs.ActivityRating is null
                ? "Enter a lab or field test result, or answer the activity questions below for an estimate."
                : "Enter a lab or field test result. An estimate needs your birth date and sex, plus a body-fat value or your height and a weigh-in.";

    private async Task SaveRatingAsync(int? rating)
    {
        savingRating = true;
        ratingError = null;
        try
        {
            await Data.SetActivityRatingAsync(rating);
            regular = null;
            followUp = null;
        }
        catch (Exception failure) when (failure is not OperationCanceledException)
        {
            ratingError = "Couldn't save your answers on this device. Please try again.";
        }
        finally
        {
            savingRating = false;
        }
    }

    private async Task SetMedicationAsync(ChangeEventArgs e)
    {
        savingMedication = true;
        medicationError = null;
        try
        {
            await Data.SetHeartRateLoweringMedicationAsync(e.Value is true);
        }
        catch (Exception failure) when (failure is not OperationCanceledException)
        {
            medicationError = "Couldn't save this setting on this device. Please try again.";
            medicationRender++;
        }
        finally
        {
            savingMedication = false;
        }
    }

    private void Refresh() => _ = InvokeAsync(() =>
    {
        profile = Data.Profile();
        StateHasChanged();
    });

    public void Dispose()
    {
        Data.Changed -= Refresh;
        Profiles.Changed -= Refresh;
    }
}
