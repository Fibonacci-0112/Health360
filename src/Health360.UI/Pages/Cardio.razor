@page "/train/cardio"
@using System.Globalization
@using Health360.Contracts.Training
@using Health360.Domain.Physiology
@using Health360.Domain.Training
@implements IDisposable
@inject WorkoutService Workouts
@inject BodyData Body
@inject ProfileService Profiles
@inject NavigationManager Navigation
@inject TimeProvider Clock

<div class="page">
    <div class="page-head">
        <h1>Log cardio</h1>
        <NavLink class="top-link" href="train">Train</NavLink>
    </div>
    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    <p role="status">@status</p>
    @if (physiology is null)
    {
        <p class="muted" role="status">Loading your physiology and zones</p>
    }
    else
    {
        <form class="form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <section class="card" aria-labelledby="cardio-session-title">
                <h2 id="cardio-session-title">Completed session</h2>
                <p class="muted">Choose the activity that best matches your session; its MET value is used when HR can't estimate energy.</p>
                <label class="check"><input type="checkbox" @bind="backdated" @bind:after="DatesChangedAsync" /> Enter an earlier session</label>
                @if (backdated)
                {
                    <div class="inline">
                        <div class="field"><label for="cardio-date">Date ended (device local time)</label><input id="cardio-date" type="date" @bind="endDate" @bind:after="DatesChangedAsync" /></div>
                        <div class="field"><label for="cardio-time">Time ended</label><input id="cardio-time" type="time" value="@endTime" @onchange="TimeChangedAsync" /></div>
                    </div>
                }
                else { <p class="muted">Saved as ending now.</p> }
                <div class="field">
                    <label for="cardio-activity">Activity</label>
                    <select id="cardio-activity" value="@activityCode" @onchange="ActivityChangedAsync" disabled="@(busy || saved)">
                        @foreach (var activity in CardioEnergy.Activities)
                        {
                            <option value="@activity.Code">@activity.Name (@activity.Mets METs)</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="cardio-duration">Duration (minutes)</label>
                    <input id="cardio-duration" inputmode="decimal" @bind="minutes" @bind:event="oninput" @bind:after="FormChangedAsync" disabled="@(busy || saved)" />
                </div>
                <div class="field">
                    <label for="cardio-distance">Distance (optional)</label>
                    <div class="inline">
                        <input id="cardio-distance" inputmode="decimal" @bind="distance" @bind:event="oninput" @bind:after="FormChangedAsync" disabled="@(busy || saved)" />
                        <select aria-label="Distance unit" @bind="distanceUnit" @bind:after="FormChangedAsync" disabled="@(busy || saved)">
                            @foreach (var unit in WorkoutCodes.DistanceUnits)
                            {
                                <option value="@unit">@unit</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field"><label for="cardio-elevation">Elevation gain (optional)</label><div class="inline">
                    <input id="cardio-elevation" inputmode="decimal" @bind="elevation" @bind:event="oninput" @bind:after="FormChangedAsync" />
                    <select aria-label="Elevation unit" @bind="elevationUnit" @bind:after="FormChangedAsync"><option>m</option><option>ft</option></select>
                </div></div>
                <div class="field">
                    <label for="cardio-average">Average HR (bpm, optional)</label>
                    <input id="cardio-average" inputmode="decimal" @bind="averageHr" @bind:event="oninput" @bind:after="FormChangedAsync" disabled="@(busy || saved)" />
                </div>
                <div class="field">
                    <label for="cardio-max">Max HR (bpm, optional)</label>
                    <input id="cardio-max" inputmode="decimal" @bind="maxHr" @bind:event="oninput" @bind:after="FormChangedAsync" disabled="@(busy || saved)" />
                </div>
                <div class="field">
                    <label for="cardio-rpe">Perceived effort (modified Borg 0–10, optional)</label>
                    <input id="cardio-rpe" inputmode="decimal" @bind="rpe" @bind:event="oninput" @bind:after="FormChangedAsync" disabled="@(busy || saved)" />
                </div>
                <p class="muted small">0: rest · 2–3: light · 4–5: moderate · 6–7: vigorous · 8–10: very hard. One rating cannot divide interval time.</p>
                <label class="check"><input type="checkbox" @bind="intervals" @bind:after="FormChangedAsync" disabled="@(busy || saved)" /> This session included intervals</label>
            </section>
            <section class="card" aria-labelledby="cardio-zones-title">
                <h2 id="cardio-zones-title">Heart-rate zones</h2>
                @if (zones is null)
                {
                    <p class="muted">No HR zones available. Enter measured values in Physiology, or a birth date in Settings when you're not taking HR-lowering medication.</p>
                }
                else
                {
                    <p>@zones.Method</p>
                    @if (zones.Inputs.Any(i => i.IsEstimate))
                    {
                        <p class="muted">These zones use an estimated max HR; individual values vary. A measured value can improve them.</p>
                    }
                    <p class="muted">Optional: enter minutes from your watch only when it uses these boundaries. Enter every zone, including zero; the total must equal duration. Leave all blank to use average HR or METs.</p>
                    <table>
                        <thead><tr><th scope="col">Zone</th><th scope="col">HR (bpm)</th><th scope="col">Minutes</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < zones.Zones.Count; i++)
                            {
                                var index = i;
                                var zone = zones.Zones[i];
                                <tr>
                                    <th scope="row">@zone.Name</th>
                                    <td>@Bounds(zone)</td>
                                    <td><input class="set-input" inputmode="decimal" aria-label="@($"Zone {zone.Name} minutes")"
                                               @bind="zoneMinutes[index]" @bind:event="oninput" @bind:after="FormChangedAsync" disabled="@(busy || saved)" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <NavLink href="body/physiology">View physiology</NavLink>
            </section>
            <div class="inline">
                <button type="button" class="secondary" id="preview-cardio" disabled="@(busy || saved)" @onclick="Preview">Estimate</button>
                <button type="submit" class="primary" id="save-cardio" disabled="@busy">Save cardio</button>
            </div>
            <p class="muted small">Save records this completed session on this device, ready to sync. Unfinished entries are saved on this device as you type. They resume here after a restart.</p>
        </form>
        @if (preview is not null)
        {
            <CardioEstimateView Estimate="preview" />
        }
    }
</div>

@code {
    private string elevation = "", elevationUnit = "m", endTime = "";
    private DateOnly endDate;
    private bool backdated;
    private CardioDraft? restoring;
    private Task draftSave = Task.CompletedTask;
    private string activityCode = CardioEnergy.Activities[0].Code;
    private string minutes = "";
    private string distance = "";
    private string distanceUnit = "km";
    private string averageHr = "";
    private string maxHr = "";
    private string rpe = "";
    private bool intervals;
    private string[] zoneMinutes = [];
    private CardioZones? zones;
    private CardioPhysiology? physiology;
    private CardioEstimate? preview;
    private string? profileId;
    private string? error;
    private string? status;
    private bool busy;
    // The session is stored; a retry only clears the draft, since saving again would add a second session.
    private bool saved;
    // Counts refreshes that cleared entered watch times, so Preview can tell them from the user clearing them.
    private int zoneResets;
    // Counts refreshes that cleared entered watch times, so Preview can tell whether its wait lost any.
    private int clearedZoneTimes;
    private bool loading;
    private bool disposed;
    private int refresh;
    private CancellationTokenSource? zoneWatch;
    private bool zonesReady;

    protected override void OnInitialized()
    {
        distanceUnit = Workouts.DistanceUnit;
        endDate = Workouts.Today; endTime = Clock.GetLocalNow().ToString("HH:mm", CultureInfo.InvariantCulture);
        Body.EnsureWatching();
        Body.Changed += Changed;
        Profiles.Changed += Changed;
        Changed();
    }

    private void Changed() => _ = InvokeAsync(RefreshAsync);

    // The refresh started last. A newer refresh supersedes an older one, which then returns without clearing `loading`
    // (the zone watcher starts one whenever synced zones change), so code that needs settled zones waits for this until
    // no refresh is running instead of reading a half-loaded form.
    private Task refreshing = Task.CompletedTask;

    private Task RefreshAsync() => refreshing = RefreshCoreAsync();

    private async Task SettledAsync()
    {
        while (!refreshing.IsCompleted)
        {
            try { await refreshing; }
            catch (OperationCanceledException) { }
        }
    }

    private async Task RefreshCoreAsync()
    {
        if (disposed)
        {
            return;
        }

        var generation = ++refresh;
        var currentId = Workouts.ProfileId;
        if (profileId != currentId)
        {
            zoneWatch?.Cancel();
            zoneWatch?.Dispose();
            zoneWatch = null;
            zonesReady = false;
            minutes = distance = averageHr = maxHr = rpe = elevation = "";
            backdated = false; restoring = null;
            intervals = false;
            profileId = currentId;
            zones = null;
            physiology = null;
            zoneMinutes = [];
            zoneResets++;
            saved = false;
            status = error = null;
            if (currentId is not null)
            {
                var draft = CardioJson.ParseDraft(await Workouts.ReadStateAsync("cardio"));
                if (currentId != Workouts.ProfileId || disposed) return;
                if (draft is not null && CardioEnergy.Activities.Any(a => a.Code == draft.ActivityCode))
                {
                    restoring = draft;
                    (activityCode, minutes, distance, distanceUnit, averageHr, maxHr, rpe, intervals, elevation, elevationUnit, backdated, endTime) =
                        (draft.ActivityCode, draft.Minutes, draft.Distance, draft.DistanceUnit, draft.AverageHr, draft.MaxHr, draft.Rpe, draft.Intervals,
                         draft.Elevation, draft.ElevationUnit, draft.Backdated, draft.EndTime);
                    if (DateOnly.TryParseExact(draft.EndDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)) endDate = date;
                }
                zoneWatch = new CancellationTokenSource();
                var token = zoneWatch.Token;
                // Capture the profile's enumerable before a later account change can select another owner.
                var changes = Workouts.WatchCardioZoneChanges(token);
                _ = Task.Run(() => WatchZonesAsync(changes, token), CancellationToken.None);
            }
        }

        preview = null;
        var dateForInputs = StartedOn();
        var profile = Body.Profile(dateForInputs);
        if (profile is null || currentId is null || Body.Failed || !zonesReady)
        {
            loading = false;
            if (Body.Failed)
            {
                error = "Couldn't read your physiology. Leave this page and come back to retry.";
            }

            StateHasChanged();
            return;
        }

        loading = true;
        StateHasChanged();
        try
        {
            var sport = CardioEnergy.Activities.Single(a => a.Code == activityCode).Sport;
            var loaded = await Workouts.CardioZonesAsync(sport, profile, dateForInputs);
            if (disposed || refresh != generation || Workouts.ProfileId != currentId)
            {
                return;
            }

            if (zones?.Method != loaded?.Method || zones?.StoredId != loaded?.StoredId
                || !(zones?.Zones.Select(z => z.LowerBpm) ?? []).SequenceEqual(loaded?.Zones.Select(z => z.LowerBpm) ?? []))
            {
                if (zoneMinutes.Any(t => !string.IsNullOrWhiteSpace(t)))
                {
                    status = "Zones changed. Enter your watch times again using these boundaries.";
                    clearedZoneTimes++;
                }

                zoneMinutes = new string[loaded?.Zones.Count ?? 0];
                zoneResets++;
            }

            zones = loaded;
            if (restoring is { } draft)
            {
                if (draft.ZoneKey == ZoneKey(zones) && draft.ZoneMinutes.Length == zoneMinutes.Length) zoneMinutes = draft.ZoneMinutes;
                else if (draft.ZoneMinutes.Any(t => !string.IsNullOrWhiteSpace(t))) status = "Zones changed. Re-enter the watch times using these boundaries.";
                restoring = null;
            }
            physiology = CardioPhysiology.From(profile);
            error = null;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            if (refresh == generation && !disposed)
            {
                error = "Couldn't read your zones on this device. Leave this page and come back to retry.";
            }
        }
        finally
        {
            if (!disposed && refresh == generation)
            {
                loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task ActivityChangedAsync(ChangeEventArgs e)
    {
        activityCode = e.Value as string ?? CardioEnergy.Activities[0].Code;
        await RefreshAsync();
        await FormChangedAsync();
    }

    private async Task WatchZonesAsync(IAsyncEnumerable<CardioLog.StoredZones[]> changes, CancellationToken token)
    {
        try
        {
            await foreach (var _ in changes)
            {
                await InvokeAsync(async () =>
                {
                    if (!disposed && !token.IsCancellationRequested)
                    {
                        // Publish the first form only after the watch is subscribed, so its initial
                        // notification cannot hide a form the user has already started filling in.
                        zonesReady = true;
                        await RefreshAsync();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception e) when (e is not ObjectDisposedException)
        {
            await InvokeAsync(() =>
            {
                if (!disposed && !token.IsCancellationRequested)
                {
                    ++refresh;
                    physiology = null;
                    preview = null;
                    loading = false;
                    error = "Couldn't read your zones on this device. Leave this page and come back to retry.";
                    StateHasChanged();
                }
            });
        }
    }

    private Task FormChangedAsync()
    {
        preview = null;
        if (saved || profileId is null || profileId != Workouts.ProfileId || physiology is null) return Task.CompletedTask;
        var owner = profileId;
        var json = CardioJson.SerializeDraft(new(activityCode, minutes, distance, distanceUnit, averageHr, maxHr, rpe, intervals,
            [.. zoneMinutes], ZoneKey(zones), elevation, elevationUnit, backdated, endDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), endTime));
        return draftSave = SaveAfterAsync(owner, json);
    }
    private async Task SaveAfterAsync(string owner, string json)
    {
        if (owner != Workouts.ProfileId) return;
        try { await Workouts.SaveStateAsync("cardio", json); }
        catch (Exception e) when (e is not OperationCanceledException) { error = "Couldn't save the unfinished form on this device. Keep this page open and retry."; }
    }
    private static string ZoneKey(CardioZones? value) => value is null ? "none" : value.Method + "/" + value.StoredId + "/" +
        string.Join(',', value.Zones.Select(z => z.LowerBpm.ToString("R", CultureInfo.InvariantCulture)));
    private DateTimeOffset? EndedAt()
    {
        if (!backdated) return null;
        if (!TimeOnly.TryParseExact(endTime, ["HH:mm", "HH:mm:ss"], CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))
            throw new ArgumentException("Enter a valid ending time.");
        var local = endDate.ToDateTime(time, DateTimeKind.Unspecified);
        if (Clock.LocalTimeZone.IsInvalidTime(local) || Clock.LocalTimeZone.IsAmbiguousTime(local))
            throw new ArgumentException("This local time is skipped or repeated by a clock change. Choose an unambiguous ending time.");
        return new DateTimeOffset(local, Clock.LocalTimeZone.GetUtcOffset(local));
    }
    private DateOnly StartedOn()
    {
        try
        {
            var seconds = Number(minutes) is { } m && double.IsFinite(m) && m is > 0 and <= 1440 ? m * 60 : 0;
            return DateOnly.FromDateTime(TimeZoneInfo.ConvertTime((EndedAt() ?? Clock.GetUtcNow()).AddSeconds(-seconds), Clock.LocalTimeZone).DateTime);
        }
        catch (ArgumentException) { return Workouts.Today; }
    }
    private async Task DatesChangedAsync() { await RefreshAsync(); await FormChangedAsync(); }
    private async Task TimeChangedAsync(ChangeEventArgs e) { endTime = e.Value as string ?? ""; await DatesChangedAsync(); }

    private CardioEntry Entry() => new(activityCode, (Number(minutes) ?? 0) * 60, Number(averageHr), Number(maxHr),
        zoneMinutes.Any(t => !string.IsNullOrWhiteSpace(t)) ? zoneMinutes.Select(t => (Number(t) ?? double.NaN) * 60).ToArray() : null,
        Number(rpe), intervals, Number(distance), distanceUnit, Number(elevation), elevationUnit, EndedAt());

    private static double? Number(string? value) => string.IsNullOrWhiteSpace(value) ? null
        : double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var number) ? number : double.NaN;

    private async Task Preview()
    {
        preview = null;
        error = null;
        // A tap that lands while a background refresh runs waits for it rather than failing or doing nothing. If that
        // refresh swapped the zone set and cleared watch times (entered before the tap or typed during the wait), stop
        // and ask for them again, rather than estimating without them.
        var clearedBefore = clearedZoneTimes;
        await SettledAsync();
        if (clearedZoneTimes != clearedBefore)
        {
            error = "Zones changed for this session's start date. Enter your watch times again using the boundaries shown.";
            return;
        }

        if (physiology is null || loading || profileId != Workouts.ProfileId)
        {
            error = "Wait for your physiology and zones to load.";
            return;
        }

        CardioEntry entry;
        try { entry = Entry(); }
        catch (ArgumentException e) { error = e.Message; return; }
        if (entry.EndedAt > Clock.GetUtcNow()) { error = "A completed session cannot end in the future."; return; }
        var shownZones = ZoneKey(zones);
        var resets = zoneResets;
        await RefreshAsync();
        await SettledAsync();
        if (physiology is null || loading || error is not null || Body.Failed || !zonesReady || profileId != Workouts.ProfileId) return;
        // The start date can move onto another zone set without a refresh; never swap watch times for a fallback.
        if (entry.ZoneSeconds is not null && (ZoneKey(zones) != shownZones || zoneResets != resets))
        {
            error = "Zones changed for this session's start date. Enter your watch times again using the boundaries shown.";
            return;
        }
        entry = Entry();
        var errors = CardioEnergy.Errors(entry, zones);
        if (errors.Count > 0)
        {
            error = string.Join(" ", errors);
            return;
        }

        preview = CardioEnergy.Estimate(entry, physiology, zones);
    }

    private async Task SaveAsync()
    {
        if (busy)
        {
            return;
        }

        // Busy from the first await on: the preview can wait for a zone refresh, and a second tap meanwhile must not
        // save the session again.
        busy = true;
        try
        {
            if (!saved)
            {
                await Preview();
                if (preview is null)
                {
                    return;
                }
            }

            var estimate = preview;
            var owner = profileId;
            await draftSave;
            if (disposed || owner != Workouts.ProfileId) return;
            if (!saved && estimate is not null)
            {
                try { await Workouts.SaveCardioAsync(estimate.Entry, estimate.Physiology, estimate.Zones); }
                catch (Exception e) when (e is not OperationCanceledException)
                {
                    error = "Couldn't save the cardio session on this device. Try again.";
                    return;
                }
                saved = true;
            }

            if (disposed || owner != Workouts.ProfileId) return;
            try { await Workouts.DeleteStateAsync("cardio"); }
            catch (Exception e) when (e is not OperationCanceledException)
            {
                error = "The cardio session was saved, but this device couldn't clear the unfinished form. Tap Save cardio to retry clearing it; the session won't be saved twice.";
                return;
            }

            if (!disposed && owner == Workouts.ProfileId)
            {
                Navigation.NavigateTo("train");
            }
        }
        finally
        {
            busy = false;
        }
    }

    private static string Bounds(HeartRateZone zone) => zone.UpperBpm is { } upper
        ? $"{zone.LowerBpm.ToString("0.#", CultureInfo.InvariantCulture)} to <{upper.ToString("0.#", CultureInfo.InvariantCulture)}"
        : $"≥{zone.LowerBpm.ToString("0.#", CultureInfo.InvariantCulture)}";

    public void Dispose()
    {
        disposed = true;
        Body.Changed -= Changed;
        Profiles.Changed -= Changed;
        zoneWatch?.Cancel();
        zoneWatch?.Dispose();
    }
}
