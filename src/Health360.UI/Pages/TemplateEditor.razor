@page "/train/templates/new"
@page "/train/templates/{TemplateId}"
@using System.Globalization
@using FluentValidation
@using Health360.Contracts.Body
@using Health360.Contracts.Training
@implements IDisposable
@inject WorkoutService Workouts
@inject ProfileService Profiles
@inject NavigationManager Navigation

@* Creates or edits a workout template (FEATURES.md §1.4): its exercises in order, each with sets, a rep range, an
   optional starting load, rest, and an optional progression rule that the logger uses to plan the next load
   (docs/calculations.md, Progression). Saved to the local database; it uploads when online. *@
<div class="page">
    <div class="page-head">
        <h1>@(TemplateId is null ? "New template" : "Edit template")</h1>
        <NavLink class="top-link" href="train">Train</NavLink>
    </div>

    @if (!loaded)
    {
        <p class="muted" role="status">Loading template</p>
    }
    else if (missing)
    {
        <p class="muted">This template isn't on this device. It may have been deleted on another device.</p>
    }
    else
    {
        @if (incomplete)
        {
            <p class="muted" role="status" id="template-incomplete">@WorkoutPlans.HiddenExercises</p>
        }
        <form class="form" @onsubmit="SaveAsync" aria-label="Template">
            <div class="field">
                <label for="template-name" class="label">Name</label>
                <input id="template-name" maxlength="120" @bind="name" @bind:event="oninput" />
            </div>

            @if (rows.Count == 0)
            {
                <p class="muted">No exercises yet. Add one below.</p>
            }

            @for (var i = 0; i < rows.Count; i++)
            {
                var row = rows[i];
                var index = i;
                <section @key="row" class="card template-exercise" aria-label="@row.Name">
                    <div class="page-head">
                        <h2>@(index + 1). @row.Name</h2>
                        <div class="inline">
                            <button type="button" class="secondary compact" disabled="@(busy || index == 0)" aria-label="@($"Move {row.Name} up")"
                                    @onclick="() => Move(index, -1)">↑</button>
                            <button type="button" class="secondary compact" disabled="@(busy || index == rows.Count - 1)" aria-label="@($"Move {row.Name} down")"
                                    @onclick="() => Move(index, 1)">↓</button>
                            <button type="button" class="secondary compact" disabled="@busy" aria-label="@($"Remove {row.Name}")"
                                    @onclick="() => rows.RemoveAt(index)">Remove</button>
                        </div>
                    </div>
                    <div class="inline">
                        <div class="field">
                            <label class="label" for="@($"sets-{index}")">Sets</label>
                            <input id="@($"sets-{index}")" class="short" inputmode="numeric" @bind="row.Sets" @bind:event="oninput" />
                        </div>
                        @if (row.TracksReps)
                        {
                            <div class="field">
                                <label class="label" for="@($"min-{index}")">Reps from</label>
                                <input id="@($"min-{index}")" class="short" inputmode="numeric" @bind="row.MinReps" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label class="label" for="@($"max-{index}")">to</label>
                                <input id="@($"max-{index}")" class="short" inputmode="numeric" @bind="row.MaxReps" @bind:event="oninput" />
                            </div>
                        }
                        <div class="field">
                            <label class="label" for="@($"rest-{index}")">Rest (s)</label>
                            <input id="@($"rest-{index}")" class="short" inputmode="numeric" @bind="row.Rest" @bind:event="oninput" />
                        </div>
                    </div>
                    @if (row.TracksLoad)
                    {
                        <div class="inline">
                            <div class="field">
                                <label class="label" for="@($"load-{index}")">Starting load</label>
                                <input id="@($"load-{index}")" class="short" inputmode="decimal" placeholder="optional" @bind="row.Load" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label class="label" for="@($"unit-{index}")">Unit</label>
                                <select id="@($"unit-{index}")" value="@row.Unit" @onchange="e => row.Unit = e.Value as string ?? row.Unit">
                                    @foreach (var unit in WorkoutCodes.LoadUnits)
                                    {
                                        <option value="@unit">@unit</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label class="label" for="@($"rule-{index}")">Progression</label>
                                <select id="@($"rule-{index}")" value="@row.Kind" @onchange="e => row.Kind = e.Value as string ?? NoRule">
                                    <option value="@NoRule">None</option>
                                    <option value="double">Double: reps, then load</option>
                                    <option value="linear">Linear: load every time</option>
                                </select>
                            </div>
                            @if (row.Kind != NoRule)
                            {
                                <div class="field">
                                    <label class="label" for="@($"inc-{index}")">Increment (@row.Unit)</label>
                                    <input id="@($"inc-{index}")" class="short" inputmode="decimal" @bind="row.Increment" @bind:event="oninput" />
                                </div>
                                <div class="field">
                                    <label class="label" for="@($"deload-{index}")">Deload after misses</label>
                                    <input id="@($"deload-{index}")" class="short" inputmode="numeric" @bind="row.DeloadAfter" @bind:event="oninput" />
                                </div>
                            }
                        </div>
                        @if (row.Kind != NoRule)
                        {
                            <p class="muted small">@RuleHelp(row)</p>
                        }
                    }
                </section>
            }

            @if (error is not null)
            {
                <p class="error" role="alert">@error</p>
            }

            <div class="inline">
                <button type="submit" class="primary" id="save-template" disabled="@(busy || incomplete)">Save template</button>
                @if (TemplateId is not null)
                {
                    @if (confirmingDelete)
                    {
                        <div class="confirm" role="alertdialog" aria-labelledby="delete-question">
                            <p id="delete-question">Delete this template and its place in your schedule? Workouts done from it keep everything logged.</p>
                            <div class="inline">
                                <button type="button" class="danger" id="delete-confirm" disabled="@busy" @onclick="DeleteAsync">Delete</button>
                                <button type="button" class="secondary" disabled="@busy" @onclick="() => confirmingDelete = false">Keep</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="secondary" id="delete-template" disabled="@busy" @onclick="() => confirmingDelete = true">Delete</button>
                    }
                }
            </div>
        </form>

        <section class="card" aria-labelledby="add-exercise-title">
            <h2 id="add-exercise-title">Add an exercise</h2>
            <div class="field">
                <label for="exercise-search" class="label">Search exercises</label>
                <input id="exercise-search" value="@query" @oninput="SearchAsync" autocomplete="off" />
            </div>
            @if (results.Length > 0)
            {
                <ul class="measurement-list" aria-label="Matching exercises">
                    @foreach (var result in results)
                    {
                        <li @key="result.Id" class="measurement">
                            <span>@result.Name</span>
                            <button type="button" class="secondary compact" disabled="@busy" aria-label="@($"Add {result.Name}")"
                                    @onclick="() => Add(result)">Add</button>
                        </li>
                    }
                </ul>
            }
            else if (!string.IsNullOrWhiteSpace(query))
            {
                <p class="muted">No exercise matches. The library arrives with the first sync.</p>
            }
        </section>
    }
</div>

@code {
    private const string NoRule = "none";

    [Parameter]
    public string? TemplateId { get; set; }

    private bool loaded;
    private bool missing;
    private bool incomplete;
    private bool busy;
    private bool confirmingDelete;
    private string? error;
    private string name = "";
    private List<Row> rows = [];
    private string? query;
    private ExerciseRow[] results = [];
    private string? loadedFor;

    /// <summary>The template's rows as loaded: saving refuses if the template gained a row since (on another device).</summary>
    private List<string> loadedIds = [];

    /// <summary>One exercise of the template as the form edits it: text as typed, parsed on save.</summary>
    private sealed class Row
    {
        public string? Id { get; init; }

        public string ExerciseId { get; init; } = "";

        public string Name { get; init; } = "";

        public string TrackingType { get; init; } = "weight_reps";

        public bool TracksLoad => TrackingType == "weight_reps";

        public bool TracksReps => TrackingType is "weight_reps" or "reps";

        public string Sets { get; set; } = "3";

        public string MinReps { get; set; } = "8";

        public string MaxReps { get; set; } = "12";

        public string Rest { get; set; } = "";

        public string Load { get; set; } = "";

        public string Unit { get; set; } = "kg";

        public string Kind { get; set; } = NoRule;

        public string Increment { get; set; } = "";

        public string DeloadAfter { get; set; } = "3";

        /// <summary>
        /// The stored starting load and increment and the text first shown for them: a field left as shown saves the
        /// stored value, in its own unit, rather than the text parsed back.
        /// </summary>
        public (double Load, string Unit, string Shown)? StoredLoad { get; init; }

        public (double Increment, string Shown)? StoredIncrement { get; init; }

        public string ShownUnit { get; init; } = "";
    }

    protected override void OnInitialized() => Profiles.Changed += ProfileChanged;

    // It also fires when the profile row is refreshed or synced; LoadAsync reloads only for another profile, so
    // unsaved edits survive that.
    private void ProfileChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    protected override Task OnParametersSetAsync() => LoadAsync();

    /// <summary>Reads the template once per profile and template; another profile's template never stays on screen.</summary>
    private async Task LoadAsync()
    {
        var key = $"{Workouts.ProfileId}/{TemplateId}";
        if (key == loadedFor)
        {
            return;
        }

        loadedFor = key;
        (loaded, missing, incomplete, error, name, rows, loadedIds, query, results, confirmingDelete) = (false, false, false, null, "", [], [], null, [], false);
        if (Workouts.ProfileId is null)
        {
            return;
        }

        try
        {
            if (TemplateId is { } id)
            {
                var template = await Workouts.TemplateAsync(id);
                var exercises = template is null ? [] : await Workouts.TemplateExercisesAsync(id);
                if (key != loadedFor)
                {
                    return;
                }

                missing = template is null;
                name = template?.Name ?? "";
                rows = [.. exercises.Select(FromRow)];
                loadedIds = [.. exercises.Select(e => e.Id)];

                // The count includes rows whose exercise hasn't synced; the list leaves them out, so saving would drop them.
                incomplete = template is not null && template.ExerciseCount > exercises.Length;
            }

            loaded = true;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            loaded = true;
            missing = true;
            error = "Couldn't read the template on this device. Leave and come back to try again.";
        }
    }

    private Row FromRow(TemplateExerciseRow e)
    {
        var scheme = e.Scheme;
        var rule = e.Rule;
        var unit = rule?.IncrementUnit ?? scheme?.LoadUnit ?? Workouts.LoadUnit;
        var shownLoad = scheme?.Load is { } stored && scheme.LoadUnit is { } storedUnit ? Number(UnitCodes.Convert(stored, storedUnit, unit) ?? stored) : null;
        return new Row
        {
            Id = e.Id,
            ExerciseId = e.ExerciseId,
            Name = e.ExerciseName,
            TrackingType = e.TrackingType,
            Sets = Text(scheme?.Sets ?? 3),
            MinReps = Text(scheme?.MinReps ?? 8),
            MaxReps = Text(scheme?.MaxReps ?? 12),
            Rest = e.RestSeconds is { } rest ? Text(rest) : "",
            // A starting load in another unit than the rule's is shown in the rule's, since one unit serves both.
            Load = shownLoad ?? "",
            Unit = unit,
            ShownUnit = unit,
            StoredLoad = scheme?.Load is { } load && scheme.LoadUnit is { } from ? (load, from, shownLoad!) : null,
            Kind = rule?.Kind ?? NoRule,
            Increment = rule is null ? DefaultIncrement(unit) : Number(rule.Increment),
            StoredIncrement = rule is null ? null : (rule.Increment, Number(rule.Increment)),
            DeloadAfter = Text(rule?.DeloadAfter ?? 3),
        };
    }

    private void Add(ExerciseRow exercise)
    {
        var unit = Workouts.LoadUnit;
        rows.Add(new Row
        {
            ExerciseId = exercise.Id,
            Name = exercise.Name,
            TrackingType = exercise.TrackingType,
            Unit = unit,
            Increment = DefaultIncrement(unit),
            MinReps = exercise.TrackingType is "weight_reps" or "reps" ? "8" : "1",
            MaxReps = exercise.TrackingType is "weight_reps" or "reps" ? "12" : "1",
        });
        query = null;
        results = [];
    }

    private void Move(int index, int by)
    {
        var to = index + by;
        if (to < 0 || to >= rows.Count)
        {
            return;
        }

        (rows[index], rows[to]) = (rows[to], rows[index]);
    }

    private async Task SearchAsync(ChangeEventArgs e)
    {
        var typed = e.Value as string;
        var loadedAs = loadedFor;
        query = typed;
        try
        {
            var found = string.IsNullOrWhiteSpace(typed) ? [] : await Workouts.SearchExercisesAsync(typed);
            // A slower search for earlier text, or one started before a profile change, must not replace what's
            // shown for the text in the box now.
            if (query == typed && loadedFor == loadedAs)
            {
                results = found;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            error = "Couldn't search the exercise library on this device.";
        }
    }

    /// <summary>The form as template rows, or the first problem in it.</summary>
    private (List<TemplateExerciseInput>? Exercises, string? Problem) Parse()
    {
        var exercises = new List<TemplateExerciseInput>();
        foreach (var row in rows)
        {
            if (!Whole(row.Sets, out var sets))
            {
                return (null, $"{row.Name}: enter the sets as a whole number.");
            }

            var min = 1;
            var max = 1;
            if (row.TracksReps && (!Whole(row.MinReps, out min) || !Whole(row.MaxReps, out max)))
            {
                return (null, $"{row.Name}: enter the reps as whole numbers.");
            }

            int? rest = null;
            if (!string.IsNullOrWhiteSpace(row.Rest))
            {
                if (!Whole(row.Rest, out var seconds))
                {
                    return (null, $"{row.Name}: enter the rest in whole seconds.");
                }

                rest = seconds;
            }

            double? load = null;
            var loadUnit = row.Unit;
            ProgressionRule? rule = null;
            if (row.TracksLoad)
            {
                var unitKept = row.Unit == row.ShownUnit;
                if (unitKept && row.StoredLoad is { } stored && row.Load == stored.Shown)
                {
                    (load, loadUnit) = (stored.Load, stored.Unit);
                }
                else if (!string.IsNullOrWhiteSpace(row.Load))
                {
                    load = NumberText.Parse(row.Load);
                    if (load is null)
                    {
                        return (null, $"{row.Name}: enter the starting load as a number.");
                    }
                }

                if (row.Kind != NoRule)
                {
                    var increment = unitKept && row.StoredIncrement is { } kept && row.Increment == kept.Shown
                        ? kept.Increment
                        : NumberText.Parse(row.Increment);
                    if (increment is null)
                    {
                        return (null, $"{row.Name}: enter the increment as a number.");
                    }

                    if (!Whole(row.DeloadAfter, out var deload))
                    {
                        return (null, $"{row.Name}: enter the misses before a deload as a whole number (0 for never).");
                    }

                    rule = new ProgressionRule(row.Kind, increment.Value, row.Unit, deload);
                }
            }

            var scheme = new SetScheme(sets, min, max, load, load is null ? null : loadUnit);
            exercises.Add(new TemplateExerciseInput(row.ExerciseId, scheme, rest, rule, row.Id));
        }

        return (exercises, null);
    }

    private async Task SaveAsync()
    {
        error = null;
        if (incomplete)
        {
            error = WorkoutPlans.HiddenExercises;
            return;
        }

        if (!WorkoutCodes.IsName(name))
        {
            error = "Give the template a name of up to 120 characters.";
            return;
        }

        var (exercises, problem) = Parse();
        if (exercises is null)
        {
            error = problem;
            return;
        }

        busy = true;
        try
        {
            if (TemplateId is { } id)
            {
                await Workouts.UpdateTemplateAsync(id, name, exercises, loadedIds);
            }
            else
            {
                await Workouts.CreateTemplateAsync(name, exercises);
            }

            Navigation.NavigateTo("train");
        }
        catch (ValidationException e)
        {
            error = e.Errors.FirstOrDefault()?.ErrorMessage ?? "Check the template's values.";
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException)
        {
            error = e.Message;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            error = "Couldn't save the template on this device. Try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (TemplateId is not { } id)
        {
            return;
        }

        busy = true;
        error = null;
        try
        {
            await Workouts.DeleteTemplateAsync(id);
            Navigation.NavigateTo("train");
        }
        catch (InvalidOperationException e)
        {
            error = e.Message;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            error = "Couldn't delete the template on this device. Try again.";
        }
        finally
        {
            busy = false;
            confirmingDelete = false;
        }
    }

    private static string RuleHelp(Row row) => row.Kind == "linear"
        ? $"When every set reaches {Shown(row.MaxReps)} reps, the next workout adds the increment."
        : $"Reps climb from {Shown(row.MinReps)} to {Shown(row.MaxReps)} at the same load; when every set reaches {Shown(row.MaxReps)}, the load goes up and reps start again from {Shown(row.MinReps)}.";

    private static string Shown(string text) => string.IsNullOrWhiteSpace(text) ? "…" : text.Trim();

    private static string DefaultIncrement(string unit) => unit == "lb" ? "5" : "2.5";

    private static bool Whole(string? text, out int value) =>
        int.TryParse(text?.Trim(), NumberStyles.None, CultureInfo.InvariantCulture, out value);

    private static string Text(long value) => value.ToString(CultureInfo.InvariantCulture);

    // Plain decimal text (never 1E-06, which the form's parser doesn't read), to 15 significant digits through
    // decimal, so a stored value isn't rounded to three places on its way to the form.
    private static string Number(double value) =>
        double.IsFinite(value) && Math.Abs(value) < 1e15
            ? ((decimal)value).ToString(CultureInfo.InvariantCulture)
            : value.ToString(CultureInfo.InvariantCulture);

    public void Dispose() => Profiles.Changed -= ProfileChanged;
}
