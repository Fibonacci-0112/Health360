@page "/train"
@using Health360.Contracts.Training
@using Health360.Domain.Training
@implements IDisposable
@inject WorkoutService Workouts
@inject ProfileService Profiles
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* Train tab (FEATURES.md §1.4): the workout in progress, what's planned this week, starting a workout (empty or
   from a template), templates to create and edit, recent workouts and personal records. *@
<div class="page">
    <div class="page-head">
        <h1>Train</h1>
        <NavLink href="train/setup">Programs, locations and calendar</NavLink>
    </div>

    @if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }

    @if (!loaded)
    {
        <p class="muted" role="status">Loading workouts</p>
    }
    else
    {
        @if (active is not null)
        {
            <section class="card" aria-labelledby="active-title">
                <h2 id="active-title">Workout in progress</h2>
                <p>
                    <span class="strong">@(active.TemplateName ?? "Workout")</span>
                    <span class="muted"> · started @StartedAt(active) · @Sets(active.CompletedSets) done</span>
                </p>
                <div class="inline">
                    <button type="button" class="primary" id="resume" @onclick="@(() => Navigation.NavigateTo($"train/workout/{active.Id}"))">Resume</button>
                </div>
            </section>
        }
        else
        {
            <section class="card" aria-labelledby="start-title">
                <h2 id="start-title">Start a workout</h2>
                <div class="inline">
                    <button type="button" class="primary" id="start-empty" disabled="@busy" @onclick="() => StartAsync(null, null)">Empty workout</button>
                    <NavLink class="top-link" href="train/cardio">Log cardio</NavLink>
                </div>
            </section>
        }

        <section class="card" aria-labelledby="templates-title">
            <div class="page-head">
                <h2 id="templates-title">Templates</h2>
                <button type="button" class="secondary compact" id="new-template" @onclick="@(() => Navigation.NavigateTo("train/templates/new"))">New template</button>
            </div>
            @if (templates.Length == 0)
            {
                <p class="muted">None yet. A template lists exercises with their sets, reps and how the load progresses.</p>
            }
            else
            {
                <ul class="measurement-list" aria-label="Templates">
                    @foreach (var template in templates)
                    {
                        <li @key="template.Id" class="measurement">
                            <div class="measurement-text">
                                <span class="strong">@template.Name</span>
                                <span class="muted small">@Exercises(template.ExerciseCount)</span>
                            </div>
                            <div class="inline">
                                <button type="button" class="secondary compact" aria-label="@($"Edit {template.Name}")"
                                        @onclick="@(() => Navigation.NavigateTo($"train/templates/{template.Id}"))">Edit</button>
                                @if (active is null)
                                {
                                    <button type="button" class="secondary" disabled="@busy" aria-label="@($"Start {template.Name}")"
                                            @onclick="() => StartAsync(template.Id, null)">Start</button>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card" aria-labelledby="planned-title">
            <h2 id="planned-title">This week</h2>
            @if (planned.Count == 0)
            {
                <p class="muted">Nothing planned for the next 7 days.</p>
            }
            else
            {
                <ul class="measurement-list">
                    @foreach (var plan in planned)
                    {
                        <li @key="@($"{plan.ScheduledId}-{plan.Date}")" class="measurement">
                            <div class="measurement-text">
                                <span class="strong">@plan.TemplateName</span>
                                <span class="muted small">@Day(plan.Date)@(plan.SessionId is null ? "" : " · done")</span>
                            </div>
                            @if (active is null && plan.SessionId is null && plan.Date == Workouts.Today)
                            {
                                <button type="button" class="secondary" disabled="@busy" aria-label="@($"Start {plan.TemplateName}")"
                                        @onclick="() => StartAsync(plan.TemplateId, plan.ScheduledId)">Start</button>
                            }
                        </li>
                    }
                </ul>
            }
        </section>

        <section class="card" aria-labelledby="cardio-week-title">
            <h2 id="cardio-week-title">Cardio this week</h2>
            @if (cardio.Length == 0)
            {
                <p class="muted">No cardio logged this week.</p>
            }
            else
            {
                var estimates = cardio.Select(c => c.Estimate).OfType<CardioEstimate>().ToArray();
                var withEnergy = estimates.Where(e => e.Kcal is not null).ToArray();
                var withSplit = estimates.Where(e => e.AerobicSeconds is not null && e.AnaerobicSeconds is not null).ToArray();
                <p>@cardio.Length sessions · @Number(estimates.Sum(e => e.Entry.DurationSeconds) / 60) minutes logged (@estimates.Length of @cardio.Length sessions readable)</p>
                @if (withEnergy.Length > 0)
                {
                    <p>@Number(Energy(withEnergy.Sum(e => e.Kcal!.Low)))–@Number(Energy(withEnergy.Sum(e => e.Kcal!.High))) @EnergyUnitCode (estimated, @withEnergy.Length of @cardio.Length sessions)</p>
                }
                @if (withSplit.Length > 0)
                {
                    <p>Aerobic @Number(withSplit.Sum(e => e.AerobicSeconds!.Value) / 60) min · Anaerobic @Number(withSplit.Sum(e => e.AnaerobicSeconds!.Value) / 60) min (@withSplit.Length of @cardio.Length sessions)</p>
                    <p class="muted small">These labels describe intensity; both energy systems work at every intensity.</p>
                }
                var withFuel = estimates.Where(e => e.Fuel is not null).ToArray();
                var withIntensity = estimates.Where(e => e.Intensity is not null).ToArray();
                @if (withFuel.Length > 0)
                {
                    <p>Fat @Number(Energy(withFuel.Sum(e => e.Fuel!.FatKcal.Low)))–@Number(Energy(withFuel.Sum(e => e.Fuel!.FatKcal.High))) @EnergyUnitCode · Carbohydrate @Number(Energy(withFuel.Sum(e => e.Fuel!.CarbKcal.Low)))–@Number(Energy(withFuel.Sum(e => e.Fuel!.CarbKcal.High))) @EnergyUnitCode (@withFuel.Length of @cardio.Length sessions)</p>
                }
                @if (withIntensity.Length > 0)
                {
                    <p>Low @Number(withIntensity.Sum(e => e.Intensity!.LowSeconds) / 60) min · Moderate @Number(withIntensity.Sum(e => e.Intensity!.ModerateSeconds) / 60) min · High @Number(withIntensity.Sum(e => e.Intensity!.HighSeconds) / 60) min (@withIntensity.Length of @cardio.Length sessions)</p>
                }
                <p class="muted small">Saved session estimates; later physiology or zone changes leave them unchanged. Not added to your calorie target.</p>
                @foreach (var session in cardio)
                {
                    @if (session.Estimate is { } estimate)
                    {
                        <details @key="session.Id">
                            <summary>@session.LocalDate · @estimate.Activity.Name</summary>
                            <CardioEstimateView Estimate="estimate" />
                        </details>
                    }
                }
            }
        </section>

        <section class="card" aria-labelledby="volume-title">
            <h2 id="volume-title">Training this week</h2>
            @if (volume.Length == 0) { <p class="muted">No completed work sets this week.</p> }
            else
            {
                <table><thead><tr><th scope="col">Primary muscle</th><th scope="col">Sets</th><th scope="col">Volume (@Workouts.LoadUnit × reps)</th></tr></thead>
                    <tbody>@foreach (var muscle in volume) { <tr><th scope="row">@muscle.Muscle.Replace('_', ' ')</th><td>@muscle.Sets</td><td>@Number(UnitCodes.Convert(muscle.VolumeKg, "kg", Workouts.LoadUnit)!.Value)</td></tr> }</tbody>
                </table>
                <p class="muted small">Completed non-warm-up sets from finished workouts, Monday–Sunday. A set counts for every primary muscle; these are not additive across muscles. Volume is external weight × reps.</p>
            }
            <div class="field"><label for="history-exercise">Estimated 1RM history</label><select id="history-exercise" @bind="historyExercise" @bind:after="LoadHistoryAsync">
                <option value="">Choose exercise</option>
                @foreach (var exercise in records.GroupBy(r => r.ExerciseId)) { <option value="@exercise.Key">@exercise.First().ExerciseName</option> }
            </select></div>
            @if (!string.IsNullOrEmpty(historyExercise)) { <E1rmChart Points="history" Unit="@Workouts.LoadUnit" Name="@(records.FirstOrDefault(r => r.ExerciseId == historyExercise)?.ExerciseName ?? "Exercise")" /> }
        </section>
        <PlateCalculator @key="watchedProfile" />
        <section class="card" aria-labelledby="records-title">
            <h2 id="records-title">Personal records</h2>
            @if (records.Length == 0)
            {
                <p class="muted">None yet. A set that beats your earlier best for an exercise shows up here.</p>
            }
            else
            {
                <ul class="measurement-list">
                    @foreach (var record in records.Take(10))
                    {
                        <li @key="record.Id" class="measurement">
                            <div class="measurement-text">
                                <span class="strong">@record.ExerciseName</span>
                                <span>@RecordText(record)</span>
                                <span class="muted small">@record.LocalDate</span>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>

        @if (recent.Length > 0)
        {
            <section class="card" aria-labelledby="recent-title">
                <h2 id="recent-title">Recent workouts</h2>
                <ul class="measurement-list">
                    @foreach (var session in recent)
                    {
                        <li @key="session.Id" class="measurement">
                            <div class="measurement-text">
                                <span class="strong">@(session.TemplateName ?? (session.Kind == "cardio" ? "Cardio" : "Workout"))</span>
                                <span class="muted small">@session.LocalDate @(session.Kind == "cardio" ? "" : $"· {Sets(session.CompletedSets)}")</span>
                                @if (CardioJson.Parse(session.EnergyEstimate) is { } estimate)
                                {
                                    <details><summary>Session estimate</summary><CardioEstimateView Estimate="estimate" /></details>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</div>

@code {
    private bool loaded;
    private bool busy;
    private string? error;
    private SessionRow? active;
    private TemplateRow[] templates = [];
    private IReadOnlyList<PlannedWorkout> planned = [];
    private PersonalRecordRow[] records = [];
    private SessionRow[] recent = [];
    private CardioSessionRow[] cardio = [];
    private MuscleVolumeRow[] volume = [];
    private E1rmPoint[] history = [];
    private string historyExercise = "";
    private async Task LoadHistoryAsync()
    {
        var profile = Workouts.ProfileId;
        var exercise = historyExercise;
        var loaded = string.IsNullOrEmpty(exercise) ? [] : await Workouts.E1rmHistoryAsync(exercise);
        if (profile == Workouts.ProfileId && exercise == historyExercise) history = loaded;
    }

    // The error a load that succeeds clears. Any other error answers the user's last tap and stays until their next one,
    // so a background reload (a sync, another device's change) cannot hide it.
    private const string ReadFailed = "Couldn't read your workouts on this device. Leave this tab and come back to try again.";
    private CancellationTokenSource? watch;
    private string? watchedProfile;

    protected override void OnInitialized()
    {
        Profiles.Changed += ProfileChanged;
        Follow();
    }

    private void ProfileChanged() => _ = InvokeAsync(() =>
    {
        if (Workouts.ProfileId == watchedProfile)
        {
            StateHasChanged();
        }
        else
        {
            Follow();
        }
    });

    /// <summary>
    /// Watches everything the tab shows; every change (a set ticked off, a workout started or finished, a schedule or
    /// record synced from another device) reloads it.
    /// </summary>
    private void Follow()
    {
        var profileId = Workouts.ProfileId;
        if (profileId == watchedProfile)
        {
            return;
        }

        // Another profile (or none): nothing of the previous one's stays on screen.
        watch?.Cancel();
        watch?.Dispose();
        watch = null;
        watchedProfile = profileId;
        error = null;
        volume = []; history = []; historyExercise = "";
        loaded = false;
        active = null;
        templates = [];
        planned = [];
        records = [];
        recent = [];
        cardio = [];
        if (profileId is null)
        {
            return;
        }

        watch = new CancellationTokenSource();
        var token = watch.Token;
        _ = Task.Run(() => WatchAsync(token), CancellationToken.None);
        _ = Task.Run(() => WatchDateAsync(token), CancellationToken.None);
    }

    private async Task WatchDateAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1), Clock);
        var date = Workouts.Today;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                var today = Workouts.Today;
                if (today == date)
                {
                    continue;
                }

                date = today;
                await InvokeAsync(async () =>
                {
                    if (!token.IsCancellationRequested)
                    {
                        await LoadAsync(token);
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task WatchAsync(CancellationToken token)
    {
        try
        {
            await foreach (var _ in Workouts.WatchTrainChanges(token))
            {
                await InvokeAsync(async () =>
                {
                    if (!token.IsCancellationRequested)
                    {
                        await LoadAsync(token);
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception e) when (e is not ObjectDisposedException)
        {
            await InvokeAsync(() =>
            {
                if (!token.IsCancellationRequested)
                {
                    error = ReadFailed;
                    watchedProfile = null;
                    StateHasChanged();
                }
            });
        }
    }

    /// <summary>
    /// Reads everything the tab shows, then publishes it only if the watch that asked is still current: a load that
    /// spans a profile change must not put the previous profile's workouts back on screen.
    /// </summary>
    private async Task LoadAsync(CancellationToken token)
    {
        if (Workouts.ProfileId is null)
        {
            return;
        }

        try
        {
            var newActive = await Workouts.ActiveSessionAsync();
            var newTemplates = await Workouts.TemplatesAsync();
            var newPlanned = await Workouts.PlannedAsync(Workouts.Today, Workouts.Today.AddDays(6));
            var newRecords = await Workouts.RecordsAsync();
            var newRecent = await Workouts.RecentSessionsAsync();
            var today = Workouts.Today;
            var monday = today.AddDays(-(((int)today.DayOfWeek + 6) % 7));
            var newCardio = await Workouts.CardioSessionsAsync(monday, monday.AddDays(6));
            var newVolume = await Workouts.MuscleVolumeAsync(monday, monday.AddDays(6));
            await LoadHistoryAsync();
            if (token.IsCancellationRequested)
            {
                return;
            }

            (active, templates, planned, records, recent) = (newActive, newTemplates, newPlanned, newRecords, newRecent);
            cardio = newCardio;
            volume = newVolume;
            loaded = true;
            if (error is ReadFailed) error = null;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            if (!token.IsCancellationRequested)
            {
                error = ReadFailed;
            }
        }
    }

    private async Task StartAsync(string? templateId, string? scheduledId)
    {
        busy = true;
        error = null;
        try
        {
            var id = await Workouts.StartAsync(templateId, scheduledId);
            Navigation.NavigateTo($"train/workout/{id}");
        }
        catch (InvalidOperationException e)
        {
            error = e.Message;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            error = "Couldn't start the workout on this device. Try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private string RecordText(PersonalRecordRow record) => record.Kind switch
    {
        "e1rm" => $"Estimated 1RM {Workouts.Load(record.Value)} ({Workouts.Load(record.WeightKg)} × {record.Reps}, {Formula(record.E1rmFormula)})",
        "weight" => $"Heaviest {Workouts.Load(record.Value)} × {record.Reps}",
        "reps" => $"{record.Reps} reps at {Workouts.Load(record.WeightKg)}",
        "volume" => $"Set volume {Workouts.Load(record.Value)} ({Workouts.Load(record.WeightKg)} × {record.Reps})",
        _ => record.Kind,
    };

    private static string Formula(string? code) => code == "brzycki" ? "Brzycki" : "Epley";

    private static string Number(double value) => value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string EnergyUnitCode => UnitPrefOptions.Energy.ToCode(Profiles.UnitPrefs.Energy);

    private double Energy(double kcal) => UnitCodes.Convert(kcal, "kcal", EnergyUnitCode)!.Value;

    private static string Sets(long count) => count == 1 ? "1 set" : $"{count} sets";

    private static string Exercises(long count) => count == 1 ? "1 exercise" : $"{count} exercises";

    private static string Day(DateOnly date) => date.ToString("ddd d MMM", System.Globalization.CultureInfo.InvariantCulture);

    private string StartedAt(SessionRow session) =>
        DateTimeOffset.TryParse(session.StartedAt, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.AssumeUniversal, out var at)
            ? TimeZoneInfo.ConvertTime(at, Clock.LocalTimeZone).ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)
            : session.LocalDate;

    public void Dispose()
    {
        Profiles.Changed -= ProfileChanged;
        watch?.Cancel();
        watch?.Dispose();
    }
}
