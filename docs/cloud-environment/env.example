# Environment variables for a Claude Code cloud environment running Health360.
# Paste the non-secret block into: environment settings -> Environment variables.
# The setup script can't read these; they apply to the session.

# --- Non-secret (safe to paste as is) -------------------------------------
# Quieter, non-interactive tooling
DO_NOT_TRACK=1
EXPO_NO_TELEMETRY=1
TURBO_TELEMETRY_DISABLED=1
# Metro bundling and `expo export -p web` run out of heap on the 2 GB default
NODE_OPTIONS=--max-old-space-size=4096
# Local stack from `supabase start` and powersync/docker-compose.yml
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:8080
# PLAN.md 3: model is configurable per function; this is the default
ANTHROPIC_MODEL=claude-opus-5-5

# --- Secrets (optional; add only when a task needs them) ------------------
# Put these under Network secrets if offered, otherwise as variables.
# Never paste their values into chat. Prefer the narrowest-scoped token.
# ANTHROPIC_API_KEY=      # AI evals (evals/) and `supabase functions serve` with live Claude calls
# EXPO_TOKEN=             # EAS builds / updates (`eas build`, `eas update`)
# SUPABASE_ACCESS_TOKEN=  # `supabase link`, `db push`, `gen types` against the hosted project
# USDA_FDC_API_KEY=       # tools/importers USDA FoodData Central import
# SENTRY_AUTH_TOKEN=      # source-map upload, once Sentry is wired up
