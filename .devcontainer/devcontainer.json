{
  "name": "Health360 Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0.403"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit"
      ]
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [
    54321,
    54324,
    8080
  ],
  "postCreateCommand": "bash tools/codespaces/install-supabase-cli.sh && dotnet restore Health360.Core.slnf -p:ContinuousIntegrationBuild=true"
}
