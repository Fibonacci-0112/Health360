{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Health360",
  "version": "0.0.0",
  "identifier": "app.health360.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "pnpm --filter @health360/app web",
    "beforeBuildCommand": "pnpm --filter @health360/app export:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Health360",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.supabase.co",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://*.powersync.journeyapps.com wss://*.powersync.journeyapps.com http://127.0.0.1:54321 http://127.0.0.1:8080 http://localhost:54321 http://localhost:8080"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "HealthcareAndFitness",
    "shortDescription": "Plan and reach your health and fitness goals"
  }
}
