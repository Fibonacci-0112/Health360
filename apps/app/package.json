{
  "name": "@health360/app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "export:web": "powersync-web copy-assets -o public && expo export -p web",
    "postinstall": "powersync-web copy-assets -o public",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@health360/api": "workspace:*",
    "@health360/domain": "workspace:*",
    "@health360/local-db": "workspace:*",
    "@health360/schemas": "workspace:*",
    "@journeyapps/wa-sqlite": "^2.0.8",
    "@op-engineering/op-sqlite": "^18.2.5",
    "@powersync/common": "^2.4.0",
    "@powersync/drizzle-driver": "^0.8.0",
    "@powersync/op-sqlite": "^0.9.16",
    "@powersync/react": "^2.1.0",
    "@powersync/react-native": "^2.3.3",
    "@powersync/web": "^2.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/react": "~19.3.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@health360/config": "workspace:*",
    "eslint": "^10.13.0",
    "vitest": "^5.0.5"
  }
}
