root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,razor}]
indent_size = 4

[*.{csproj,props,targets,slnx,xaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

# Style
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = when_multiline:warning
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
dotnet_diagnostic.IDE0005.severity = warning # unnecessary usings
dotnet_diagnostic.IDE0161.severity = warning # file-scoped namespaces

# Test method names use underscores for readability.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
