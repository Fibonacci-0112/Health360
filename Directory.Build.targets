<Project>
  <!--
    Read after each project file, so project properties such as UseMaui are already set here
    (Directory.Build.props is read before them).
  -->
  <PropertyGroup Condition="'$(UseMaui)' != 'true'">
    <!-- Projects that test locale behaviour (the MAUI app keeps culture data) set UseCultureData. -->
    <InvariantGlobalization Condition="'$(UseCultureData)' != 'true'">true</InvariantGlobalization>
    <!-- Lock files, restored in locked mode in CI. MAUI is left out: its restore graph differs by OS. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
